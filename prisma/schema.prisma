// amount her zaman gider toplamı (grand total) anlamındadır — mevcut tüm
// okuyucular (expense-context-builder vb.) bunu böyle kullanır, anlamı
// değiştirilmez. netAmount/taxAmount opsiyonel bir kırılımdır; ikisi de
// verildiğinde amount'a eşit olmalıdır (bkz. expense.contract.ts).
// paidAmount, ExpenseSettlement authority'sinden türeyen bir projection/
// cache'tir — source-of-truth ExpenseSettlement satırlarıdır.
model Expense {
  id                 String                @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  category           ExpenseCategory
  subcategory        String?
  amount             Decimal               @db.Decimal(14, 2)
  netAmount          Decimal?              @db.Decimal(14, 2)
  taxRate            Decimal?              @db.Decimal(5, 2)
  taxAmount          Decimal?              @db.Decimal(14, 2)
  paidAmount         Decimal               @default(0) @db.Decimal(14, 2)
  currency           String                @default("TRY")
  expenseDate        DateTime
  recurrenceType     ExpenseRecurrenceType @default(ONCE)
  status             ExpenseStatus         @default(PENDING)
  vendorName         String?
  supplierId         String?
  customerId         String?
  employeeMemberId   String?
  createdByUserId    String?
  note               String?
  cancelledAt        DateTime?
  cancelReason       String?
  // Phase 11 — bir gider bir corporate card'a atfedildiyse (corporateCardId
  // dolu), gerçek ödemesi doğrudan expense.settle üzerinden DEĞİL, kendi
  // CardStatement'ının CardStatementPayment'ı üzerinden yapılır (bkz.
  // expense-settlement.service.ts::assertExpenseNotCardManaged) — aynı
  // harcamanın hem tekil Expense ödemesi hem statement ödemesi olarak iki
  // kez nakit çıkışı üretmesini yapısal olarak engeller. cardStatementId
  // yalnız ilgili statement kapatılıp (closeCardStatement) bu gider ona
  // atandığında dolar; ondan önce null'dır (statement'a henüz atanmamış).
  corporateCardId    String?
  cardStatementId    String?
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier           Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  employeeMember     OrganizationMember?   @relation("ExpenseEmployee", fields: [employeeMemberId], references: [id], onDelete: SetNull)
  createdByUser      User?                 @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  corporateCard      CorporateCard?        @relation(fields: [corporateCardId], references: [id], onDelete: SetNull)
  cardStatement      CardStatement?        @relation(fields: [cardStatementId], references: [id], onDelete: SetNull)
  settlements        ExpenseSettlement[]
  advanceReconciliations EmployeeAdvanceReconciliation[]
  obligationScheduleLine ObligationScheduleLine?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, recurrenceType])
  @@index([organizationId, expenseDate])
  @@index([organizationId, supplierId])
  @@index([organizationId, customerId])
  @@index([organizationId, corporateCardId])
  @@index([organizationId, cardStatementId])
  @@index([expenseDate])
  @@index([status])
}

// Settlement/settlement.service.ts'in payable (OUT yönlü) karşılığı.
// Ayrı bir model olmasının nedeni: Settlement.paymentId zorunlu ve Payment'a
// bağlı — bunu Expense'i de kapsayacak şekilde polymorphic yapmak Phase 5'in
// Receivable/Payable genelleştirmesidir, bu fazda yapılmaz. ExpenseSettlement
// aynı immutable/reversal-as-new-row deseniyle payable tarafını kapsar ve
// gerçek para hareketini yine tek canonical FinancialAccountMovement
// tablosuna yazar (expenseSettlementId ile) — iki farklı finance authority
// değil, tek movement ledger'ına iki farklı giriş yolu.
model ExpenseSettlement {
  id                 String           @id @default(cuid())
  organizationId     String
  expenseId          String
  kind               SettlementKind   @default(ORIGINAL)
  amount             Decimal          @db.Decimal(14, 2)
  currency           String
  paymentMethod      PaymentMethod
  financialAccountId String
  occurredAt         DateTime
  idempotencyKey     String?
  requestHash        String?
  reason             String?
  actorId            String
  reversalOfId       String?                    @unique
  reversalOf         ExpenseSettlement?         @relation("ExpenseSettlementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           ExpenseSettlement?         @relation("ExpenseSettlementReversal")
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expense            Expense                    @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount           @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  movement           FinancialAccountMovement?

  createdAt          DateTime         @default(now())

  @@unique([organizationId, expenseId, idempotencyKey])
  @@index([organizationId, expenseId])
  @@index([organizationId, occurredAt])
  @@index([financialAccountId])
}

// Phase 9 — Purchase Invoice'ın gerçek para çıkışı. ExpenseSettlement'ın
// birebir aynası (kind/idempotency/reversal/1:1 movement), yalnız
// expenseId yerine purchaseInvoiceId'e bağlanır — Purchase Invoice ≠
// Expense invariant'ı gereği ayrı bir authority, ama AYNI kanıtlanmış
// mimari (tek satır = hem settlement hem application, ayrı bir
// Application alt-tablosu gerekmez; partial ödeme birden fazla
// SupplierPayment satırı ile desteklenir).
model SupplierPayment {
  id                 String                     @id @default(cuid())
  organizationId     String
  purchaseInvoiceId  String
  kind               SettlementKind             @default(ORIGINAL)
  amount             Decimal                    @db.Decimal(14, 2)
  currency           String
  paymentMethod      PaymentMethod
  financialAccountId String
  occurredAt         DateTime
  idempotencyKey     String?
  requestHash        String?
  reason             String?
  actorId            String
  reversalOfId       String?                    @unique
  reversalOf         SupplierPayment?           @relation("SupplierPaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           SupplierPayment?           @relation("SupplierPaymentReversal")
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseInvoice    PurchaseInvoice            @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount           @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  movement           FinancialAccountMovement?

  createdAt          DateTime                   @default(now())

  @@unique([organizationId, purchaseInvoiceId, idempotencyKey])
  @@index([organizationId, purchaseInvoiceId])
  @@index([organizationId, occurredAt])
}

// Commercial Term → Materialized Obligation Schedule (Phase 5). Bir
// component = "ne kadar, ne zaman ödenecek/tahsil edilecek" ticari sözü —
// immutable, bir kere materialize edilir, asla mutate edilmez. Settlement
// otoritesi DEĞİLDİR: hangi tutarın gerçekten tahsil/ödendiği yalnız
// linked Payment.paidAmount (Phase 3) / Expense.paidAmount (Phase 4)
// üzerinden okunur — burada tekrar eden bir "open amount" alanı yoktur,
// bilerek. Materialize etmek başlı başına para hareketi ÜRETMEZ: yalnız bu
// satırı ve (receivable ise) boş bir Payment kabuğu yaratır.
model ObligationScheduleLine {
  id                String                         @id @default(cuid())
  organizationId    String
  direction         ObligationDirection
  sourceType        ObligationSourceType
  sourceId          String
  componentIndex    Int
  allocationType    PaymentTermAllocationType
  maturityBasis     PaymentTermMaturityBasis
  referenceDateType PaymentTermReferenceDateType?
  dueDate           DateTime
  originalAmount    Decimal                        @db.Decimal(14, 2)
  currency          String
  // Phase 11 — LOAN_INSTALLMENT satırları için originalAmount'un principal/
  // interest kırılımı (originalAmount = principalAmount + interestAmount).
  // Diğer tüm sourceType'lar için null bırakılır — "Interest/fees ≠
  // Principal" invariant'ı yalnız bu iki alan doluyken anlamlıdır.
  principalAmount   Decimal?                       @db.Decimal(14, 2)
  interestAmount    Decimal?                       @db.Decimal(14, 2)
  paymentId         String?                        @unique
  expenseId         String?                        @unique
  purchaseInvoiceId String?                        @unique
  cardStatementId   String?                        @unique
  loanInstallmentId String?                        @unique
  actorId           String
  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment           Payment?                       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  expense           Expense?                       @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  purchaseInvoice   PurchaseInvoice?               @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)
  cardStatement     CardStatement?                 @relation(fields: [cardStatementId], references: [id], onDelete: Restrict)
  loanInstallment   LoanInstallment?                @relation(fields: [loanInstallmentId], references: [id], onDelete: Restrict)
  createdAt         DateTime                       @default(now())

  @@unique([organizationId, sourceType, sourceId, componentIndex])
  @@index([organizationId, direction, dueDate])
  @@index([organizationId, sourceType, sourceId])
  instrumentAllocations InstrumentAllocation[]
}

// Phase 10 — Cheque & Promissory Note Instrument Authority. A financial
// INSTRUMENT, explicitly not cash: receiving/issuing one never creates a
// FinancialAccountMovement by itself (that only happens at clearInstrument,
// which reuses the existing Settlement/SupplierPayment/ExpenseSettlement +
// FinancialAccountMovement + Ledger authority — no parallel money-movement
// path). Maturity lives here as a real column so Phase 12 can project it
// onto Calendar later without this model changing.
enum InstrumentType {
  CHEQUE
  PROMISSORY_NOTE
}

enum InstrumentDirection {
  RECEIVED
  ISSUED
}

enum InstrumentStatus {
  REGISTERED
  ALLOCATED
  CLEARED
  BOUNCED
  CANCELLED
}

model FinancialInstrument {
  id               String                @id @default(cuid())
  organizationId   String
  instrumentType   InstrumentType
  direction        InstrumentDirection
  customerId       String?
  supplierId       String?
  amount           Decimal               @db.Decimal(14, 2)
  currency         String
  issueDate        DateTime?
  maturityDate     DateTime
  instrumentNumber String?
  bankName         String?
  branchName       String?
  drawerName       String?
  status           InstrumentStatus      @default(REGISTERED)
  cancelReason     String?
  notes            String?
  actorId          String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier         Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  allocations      InstrumentAllocation[]
  statusHistory    InstrumentStatusHistory[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([organizationId, direction, status])
  @@index([organizationId, maturityDate])
  @@index([organizationId, customerId])
  @@index([organizationId, supplierId])
}

model InstrumentStatusHistory {
  id             String            @id @default(cuid())
  organizationId String
  instrumentId   String
  fromStatus     InstrumentStatus?
  toStatus       InstrumentStatus
  reason         String?
  performedById  String?
  evidence       Json?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instrument     FinancialInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@index([organizationId, instrumentId])
}

// Instrument → ObligationScheduleLine allocation — the SOLE record of "how
// much of this instrument covers which canonical obligation." Immutable:
// no update/delete, only new REVERSAL rows (bounceInstrument /
// reverseInstrumentAllocation), mirroring Application/ExpenseSettlement's
// established reversal convention exactly. settledReferenceType/Id is set
// only once clearInstrument actually creates a real Settlement/
// SupplierPayment/ExpenseSettlement row — never fabricated, never set at
// allocation time.
model InstrumentAllocation {
  id                     String                 @id @default(cuid())
  organizationId         String
  instrumentId           String
  obligationScheduleLineId String
  kind                   SettlementKind         @default(ORIGINAL)
  amount                 Decimal                @db.Decimal(14, 2)
  currency               String
  appliedAt              DateTime
  settledReferenceType   String?
  settledReferenceId     String?
  reversalOfId           String?                @unique
  reversalOf             InstrumentAllocation?  @relation("InstrumentAllocationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal               InstrumentAllocation?  @relation("InstrumentAllocationReversal")
  actorId                String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instrument             FinancialInstrument     @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  obligationScheduleLine ObligationScheduleLine  @relation(fields: [obligationScheduleLineId], references: [id], onDelete: Restrict)
  createdAt              DateTime                @default(now())

  @@index([organizationId, instrumentId])
  @@index([organizationId, obligationScheduleLineId])
}

// ============================================================================
// Phase 11 — Advanced Financial Obligations
//
// Üç yeni ekonomik olay ailesi, hepsi Phase 2-10 authority'sini reuse eder:
// hiçbiri kendi FinancialAccount/Settlement/Ledger otoritesini icat etmez.
//
// 1) Corporate Cards: bir kart harcaması zaten sıradan bir Expense'tir
//    (corporateCardId ile etiketlenir) — ekonomik tanıma expense.create ile
//    olur, aynen. Yeni olan tek şey CardStatement: bir dönemin harcamalarını
//    toplayan PAYABLE obligation. Statement kapatılınca kendi
//    ObligationScheduleLine'ı (CARD_STATEMENT) materialize edilir; gerçek
//    ödeme CardStatementPayment (ExpenseSettlement/SupplierPayment'ın birebir
//    aynası) + FinancialAccountMovement ile olur. Kart harcaması Expense'i
//    doğrudan expense.settle ile ayrıca ödenemez (bkz.
//    expense-settlement.service.ts::assertExpenseNotCardManaged) — aksi
//    halde aynı para iki kez çıkmış görünürdü.
//
// 2) Employee Advances: avans verme gerçek bir para çıkışıdır ama HİÇBİR
//    Expense üretmez (EmployeeAdvanceMovement, direction=OUT).
//    İade de gerçek bir para girişidir (direction=IN). Reconciliation
//    (EmployeeAdvanceReconciliation) nakit hareketi ÜRETMEZ — yalnız "bu
//    Expense'in şu kadarı bu avansla zaten karşılanmış" der; Financial
//    Instrument'ın applyInstrumentToObligation deseniyle birebir aynı
//    prensip: Expense.paidAmount'a DOKUNMAZ, kendi ayrı ceiling'ini
//    (sumNetReconciliationsForExpense) Expense.paidAmount'un YANINDA tutar
//    — böylece aynı Expense hem nakit hem avansla iki kez kapatılamaz.
//
// 3) Loans: LoanInstallment principal/interest kırılımını
//    ObligationScheduleLine'a (LOAN_INSTALLMENT) materialize eder.
//    Drawdown (principal alındı, gelir DEĞİL) ve Repayment (principal
//    ödendi, gider DEĞİL — yalnız interestPortion gider) ayrı, immutable,
//    kendi FinancialAccountMovement'ını üreten iki farklı olay ailesidir —
//    ExpenseSettlement/SupplierPayment ile AYNI idempotency/reversal/CAS
//    deseni.
//
// Payroll/SGK-Tax için (roadmap Phase 11 madde 4-5) YENİ authority YOK:
// mevcut Expense(category=PAYROLL|TAX) + ObligationScheduleLine(EXPENSE) +
// ExpenseSettlement zaten "accrual ≠ payment" invariant'ını tam karşılıyor —
// paralel bir payroll/tax otoritesi kurmak roadmap'in "Existing authority
// genişletilebiliyorsa parallel authority kurma" kuralını ihlal ederdi.
// ============================================================================

enum CorporateCardStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CardStatementStatus {
  OPEN
  CLOSED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum EmployeeAdvanceStatus {
  OUTSTANDING
  PARTIALLY_RECONCILED
  RECONCILED
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

model CorporateCard {
  id                 String              @id @default(cuid())
  organizationId     String
  cardholderMemberId String
  bankName           String?
  last4              String?
  label              String
  currency           String
  status             CorporateCardStatus @default(ACTIVE)
  actorId            String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cardholder         OrganizationMember  @relation("CorporateCardHolder", fields: [cardholderMemberId], references: [id], onDelete: Restrict)
  statements         CardStatement[]
  expenses           Expense[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, cardholderMemberId])
}

// Bir kartın bir dönemi = PAYABLE obligation. totalAmount OPEN iken null'dır
// (henüz kapanmamış); closeCardStatement döneme atanan gerçek Expense'lerin
// toplamını deterministik olarak hesaplar — asla dışarıdan uydurulan bir
// tutar kabul edilmez.
model CardStatement {
  id                     String                  @id @default(cuid())
  organizationId         String
  corporateCardId        String
  periodStart            DateTime
  periodEnd              DateTime
  dueDate                DateTime
  totalAmount            Decimal?                @db.Decimal(14, 2)
  currency               String
  status                 CardStatementStatus      @default(OPEN)
  closedAt               DateTime?
  actorId                String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  corporateCard          CorporateCard           @relation(fields: [corporateCardId], references: [id], onDelete: Restrict)
  expenses               Expense[]
  obligationScheduleLine ObligationScheduleLine?
  payments               CardStatementPayment[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([organizationId, corporateCardId, periodStart, periodEnd])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
}

// ExpenseSettlement/SupplierPayment'ın CardStatement aynası — birebir aynı
// immutable/idempotent/reversal-as-new-row desen.
model CardStatementPayment {
  id                 String                @id @default(cuid())
  organizationId     String
  cardStatementId    String
  kind               SettlementKind        @default(ORIGINAL)
  amount             Decimal               @db.Decimal(14, 2)
  currency           String
  paymentMethod      PaymentMethod
  financialAccountId String
  occurredAt         DateTime
  idempotencyKey     String?
  requestHash        String?
  reason             String?
  actorId            String
  reversalOfId       String?               @unique
  reversalOf         CardStatementPayment? @relation("CardStatementPaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           CardStatementPayment? @relation("CardStatementPaymentReversal")
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cardStatement      CardStatement         @relation(fields: [cardStatementId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount      @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  movement           FinancialAccountMovement?
  createdAt          DateTime              @default(now())

  @@unique([organizationId, cardStatementId, idempotencyKey])
  @@index([organizationId, cardStatementId])
  @@index([organizationId, occurredAt])
}

// reconciledAmount: cache/projection (Payment.paidAmount ile aynı statü —
// source-of-truth değil), her disbursement/return/reconciliation sonrası
// yeniden hesaplanır. Gerçek doğruluk kaynağı movements + reconciliations
// tablolarının kendisidir.
model EmployeeAdvance {
  id               String                          @id @default(cuid())
  organizationId   String
  employeeMemberId String
  amount           Decimal                         @db.Decimal(14, 2)
  currency         String
  status           EmployeeAdvanceStatus            @default(OUTSTANDING)
  reconciledAmount Decimal                          @default(0) @db.Decimal(14, 2)
  note             String?
  actorId          String
  cancelledAt      DateTime?
  cancelReason     String?
  organization     Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeMember   OrganizationMember               @relation("EmployeeAdvanceEmployee", fields: [employeeMemberId], references: [id], onDelete: Restrict)
  movements        EmployeeAdvanceMovement[]
  reconciliations  EmployeeAdvanceReconciliation[]
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, employeeMemberId])
}

// direction=OUT: disbursement (avans verildi). direction=IN: return
// (kullanılmayan avans iade edildi). Settlement modelinin (Phase 3)
// generalize edilmiş direction desenini birebir tekrar eder.
model EmployeeAdvanceMovement {
  id                 String                    @id @default(cuid())
  organizationId     String
  employeeAdvanceId  String
  kind               SettlementKind            @default(ORIGINAL)
  direction          MoneyDirection
  amount             Decimal                   @db.Decimal(14, 2)
  currency           String
  paymentMethod      PaymentMethod
  financialAccountId String
  occurredAt         DateTime
  idempotencyKey     String?
  requestHash        String?
  reason             String?
  actorId            String
  reversalOfId       String?                   @unique
  reversalOf         EmployeeAdvanceMovement?  @relation("EmployeeAdvanceMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           EmployeeAdvanceMovement?  @relation("EmployeeAdvanceMovementReversal")
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeAdvance    EmployeeAdvance           @relation(fields: [employeeAdvanceId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount          @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  movement           FinancialAccountMovement?
  createdAt          DateTime                  @default(now())

  @@unique([organizationId, employeeAdvanceId, idempotencyKey])
  @@index([organizationId, employeeAdvanceId])
  @@index([organizationId, occurredAt])
}

// Nakit hareketi ÜRETMEZ (movement/financialAccountId yok, bilerek) — yalnız
// bir Expense'in ne kadarının bu avansla zaten karşılandığını kaydeder.
// InstrumentAllocation'ın (Phase 10) "allocation ≠ settlement" prensibiyle
// aynı: gerçek para daha önce disbursement'ta hareket etti, burada yalnız
// hangi giderin ona karşılık geldiği netleştirilir.
model EmployeeAdvanceReconciliation {
  id                String                          @id @default(cuid())
  organizationId    String
  employeeAdvanceId String
  expenseId         String
  kind              SettlementKind                  @default(ORIGINAL)
  amount            Decimal                         @db.Decimal(14, 2)
  currency          String
  occurredAt        DateTime
  idempotencyKey    String?
  reason            String?
  actorId           String
  reversalOfId      String?                         @unique
  reversalOf        EmployeeAdvanceReconciliation?  @relation("EmployeeAdvanceReconciliationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal          EmployeeAdvanceReconciliation?  @relation("EmployeeAdvanceReconciliationReversal")
  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeAdvance   EmployeeAdvance                 @relation(fields: [employeeAdvanceId], references: [id], onDelete: Restrict)
  expense           Expense                         @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdAt         DateTime                        @default(now())

  @@unique([organizationId, employeeAdvanceId, expenseId, idempotencyKey])
  @@index([organizationId, employeeAdvanceId])
  @@index([organizationId, expenseId])
}

model Loan {
  id             String            @id @default(cuid())
  organizationId String
  lenderName     String
  principalAmount Decimal          @db.Decimal(14, 2)
  currency       String
  interestRate   Decimal?          @db.Decimal(7, 4)
  startDate      DateTime
  status         LoanStatus        @default(ACTIVE)
  note           String?
  actorId        String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  installments   LoanInstallment[]
  drawdowns      LoanDrawdown[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, status])
}

// principalAmount + interestAmount, materialize edildiğinde
// ObligationScheduleLine(LOAN_INSTALLMENT).originalAmount/principalAmount/
// interestAmount'a birebir kopyalanır — LoanInstallment kendisi "ne kadar,
// ne zaman" ticari sözünün detay kaydıdır; ObligationScheduleLine ise (Phase
// 5 authority) canonical "vadesi ne zaman" sorgusunun TEK yeridir.
model LoanInstallment {
  id                     String                  @id @default(cuid())
  organizationId         String
  loanId                 String
  installmentIndex       Int
  dueDate                DateTime
  principalAmount        Decimal                 @db.Decimal(14, 2)
  interestAmount         Decimal                 @default(0) @db.Decimal(14, 2)
  currency               String
  actorId                String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loan                   Loan                    @relation(fields: [loanId], references: [id], onDelete: Restrict)
  obligationScheduleLine ObligationScheduleLine?
  repayments             LoanRepayment[]
  createdAt              DateTime                @default(now())

  @@unique([organizationId, loanId, installmentIndex])
  @@index([organizationId, loanId])
  @@index([organizationId, dueDate])
}

// Principal alındı = gerçek nakit girişi, gelir DEĞİL (LedgerSourceType
// LOAN_DRAWDOWN, recordLoanDrawdown: dr cash, cr loansPayable).
model LoanDrawdown {
  id                 String            @id @default(cuid())
  organizationId     String
  loanId             String
  kind               SettlementKind    @default(ORIGINAL)
  amount             Decimal           @db.Decimal(14, 2)
  currency           String
  paymentMethod      PaymentMethod
  financialAccountId String
  occurredAt         DateTime
  idempotencyKey     String?
  requestHash        String?
  reason             String?
  actorId            String
  reversalOfId       String?           @unique
  reversalOf         LoanDrawdown?     @relation("LoanDrawdownReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           LoanDrawdown?     @relation("LoanDrawdownReversal")
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loan               Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount  @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  movement           FinancialAccountMovement?
  createdAt          DateTime          @default(now())

  @@unique([organizationId, loanId, idempotencyKey])
  @@index([organizationId, loanId])
  @@index([organizationId, occurredAt])
}

// Principal repayment ≠ expense; interestPortion = economic expense.
// principalPortion + interestPortion = amount, her zaman.
// (recordLoanRepayment: dr loansPayable(principalPortion) +
// dr generalExpense(interestPortion, varsa), cr cash.)
model LoanRepayment {
  id                 String            @id @default(cuid())
  organizationId     String
  loanInstallmentId  String
  kind               SettlementKind    @default(ORIGINAL)
  amount             Decimal           @db.Decimal(14, 2)
  principalPortion   Decimal           @db.Decimal(14, 2)
  interestPortion    Decimal           @default(0) @db.Decimal(14, 2)
  currency           String
  paymentMethod      PaymentMethod
  financialAccountId String
  occurredAt         DateTime
  idempotencyKey     String?
  requestHash        String?
  reason             String?
  actorId            String
  reversalOfId       String?           @unique
  reversalOf         LoanRepayment?    @relation("LoanRepaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           LoanRepayment?    @relation("LoanRepaymentReversal")
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loanInstallment    LoanInstallment   @relation(fields: [loanInstallmentId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount  @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  movement           FinancialAccountMovement?
  createdAt          DateTime          @default(now())

  @@unique([organizationId, loanInstallmentId, idempotencyKey])
  @@index([organizationId, loanInstallmentId])
  @@index([organizationId, occurredAt])
}

// Operational account master data only. This is deliberately not a ledger,
// settlement record, bank integration, or balance source of truth.
model FinancialAccount {
  id                String                 @id @default(cuid())
  organizationId    String
  type              FinancialAccountType
  name              String
  normalizedName    String
  currency          String
  status            FinancialAccountStatus @default(ACTIVE)
  bankName          String?
  branchName        String?
  iban              String?
  accountNumber     String?
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  settlements       Settlement[]
  movements         FinancialAccountMovement[]
  expenseSettlements ExpenseSettlement[]
  supplierPayments  SupplierPayment[]
  cardStatementPayments CardStatementPayment[]
  employeeAdvanceMovements EmployeeAdvanceMovement[]
  loanDrawdowns     LoanDrawdown[]
  loanRepayments    LoanRepayment[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([organizationId, iban])
  @@index([organizationId, status])
  @@index([organizationId, type, currency])
  @@index([organizationId, normalizedName, currency])
  @@index([organizationId, bankName, accountNumber])
}

// Gerçekleşen para olayı: bu kadar para, bu yöntemle, bu hesaba, bu tarihte
// hareket etti. Immutable — düzeltmeler reversalOfId ile yeni REVERSAL
// satırlarıdır, orijinal satır asla mutate/delete edilmez.
// idempotencyKey/requestHash istek dedupe'u içindir (replay authority);
// referenceNumber/externalReference insan-okunur mutabakat içindir (örn.
// dekont no, banka ekstresi satır referansı) — birbirinin yerine geçmez.
model Settlement {
  id                 String                     @id @default(cuid())
  organizationId     String
  paymentId          String
  kind               SettlementKind             @default(ORIGINAL)
  direction          MoneyDirection
  amount             Decimal                    @db.Decimal(14, 2)
  currency           String
  paymentMethod      PaymentMethod
  financialAccountId String
  occurredAt         DateTime
  idempotencyKey     String?
  requestHash        String?
  reason             String?
  referenceNumber    String?
  externalReference  String?
  actorId            String
  reversalOfId       String?                    @unique
  reversalOf         Settlement?                @relation("SettlementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           Settlement?                @relation("SettlementReversal")
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment            Payment                    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount           @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  applications       Application[]
  movements          FinancialAccountMovement[]
  createdAt          DateTime                   @default(now())

  @@unique([organizationId, paymentId, idempotencyKey])
  @@index([organizationId, paymentId])
  @@index([organizationId, occurredAt])
  @@index([financialAccountId])
}

// Hangi obligation'ın (Payment, Phase 3'te Receivable/Payable yerine geçiyor)
// hangi kısmının bu Settlement ile kapandığı. Kendi satırı — asla
// Payment.paidAmount increment'i değil — böylece kısmi tahsilatlar ayrı
// immutable history tutar.
model Application {
  id             String         @id @default(cuid())
  organizationId String
  settlementId   String
  paymentId      String
  kind           SettlementKind @default(ORIGINAL)
  amount         Decimal        @db.Decimal(14, 2)
  currency       String
  appliedAt      DateTime
  reversalOfId   String?        @unique
  reversalOf     Application?   @relation("ApplicationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal       Application?   @relation("ApplicationReversal")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  settlement     Settlement     @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payment        Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())

  @@index([organizationId, paymentId])
  @@index([settlementId])
}

// Gerçek FinancialAccount'a giren/çıkan gerçek para. Balance'ın
// türetilebileceği TEK tablo — hiçbir yerde mutable balance scalar yok.
model FinancialAccountMovement {
  id                 String                    @id @default(cuid())
  organizationId     String
  financialAccountId String
  settlementId       String?
  expenseSettlementId String?                  @unique
  supplierPaymentId  String?                   @unique
  cardStatementPaymentId String?               @unique
  employeeAdvanceMovementId String?            @unique
  loanDrawdownId     String?                   @unique
  loanRepaymentId    String?                   @unique
  paymentMethod      PaymentMethod
  amount             Decimal                   @db.Decimal(14, 2)
  currency           String
  occurredAt         DateTime
  direction          MoneyDirection
  provenance         Json?
  reversalOfId       String?                   @unique
  reversalOf         FinancialAccountMovement? @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           FinancialAccountMovement? @relation("MovementReversal")
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount          @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  settlement         Settlement?               @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  expenseSettlement  ExpenseSettlement?        @relation(fields: [expenseSettlementId], references: [id], onDelete: SetNull)
  supplierPayment    SupplierPayment?          @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  cardStatementPayment CardStatementPayment?   @relation(fields: [cardStatementPaymentId], references: [id], onDelete: SetNull)
  employeeAdvanceMovement EmployeeAdvanceMovement? @relation(fields: [employeeAdvanceMovementId], references: [id], onDelete: SetNull)
  loanDrawdown       LoanDrawdown?             @relation(fields: [loanDrawdownId], references: [id], onDelete: SetNull)
  loanRepayment      LoanRepayment?            @relation(fields: [loanRepaymentId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now())

  @@index([organizationId, financialAccountId, occurredAt])
  @@index([settlementId])
}

model LedgerAccount {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  type      LedgerAccountType
  lines     LedgerEntryLine[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model LedgerEntry {
  id             String            @id @default(cuid())
  organizationId String
  entryDate      DateTime
  description    String
  sourceType     LedgerSourceType
  sourceId       String
  reversalOfId   String?           @unique
  reversalOf     LedgerEntry?      @relation("LedgerEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal       LedgerEntry?      @relation("LedgerEntryReversal")
  lines          LedgerEntryLine[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@unique([organizationId, sourceType, sourceId, description])
  @@index([organizationId, entryDate])
  @@index([organizationId, sourceType, sourceId])
}

model LedgerEntryLine {
  id            String        @id @default(cuid())
  ledgerEntryId String
  accountId     String
  debitCents    BigInt        @default(0)
  creditCents   BigInt        @default(0)
  currency      String
  ledgerEntry   LedgerEntry   @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  account       LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())

  @@index([ledgerEntryId])
  @@index([accountId])
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  displayName    String
