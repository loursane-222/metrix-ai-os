}

enum AuditOutcome {
  ALLOW
  DENY
  REQUIRES_APPROVAL
  GRANTED
  CONSUMED
  REVOKED
  VALIDATION_FAILED
  ATTEMPTED
  SUCCEEDED
  NO_CHANGE
  FAILED
  CORRECTED
}

// Action Runtime'ın append-only kanıt kaydı (src/lib/action-runtime/audit).
// Ham action input'unu asla taşımaz — yalnızca inputHash ve minimize
// edilmiş metadata. entityType/entityId polymorphic'tir (Customer, Order,
// Invoice, ... her domaine karşılık gelebilir), bu yüzden gerçek bir FK
// ilişkisi yok — ActionApproval'ın targetEntityType/targetEntityId'siyle
// aynı desen.
model AuditRecord {
  id                 String          @id @default(cuid())
  organizationId     String
  recordType         AuditRecordType
  actionName         String
  actorId            String
  entityType         String?
  entityId           String?
  executionId        String?
  operationId        String?
  policyDecisionRef  String?
  approvalRef        String?
  outcome            AuditOutcome
  reasonCode         String?
  inputHash          String?
  resultSummary      String?
  correctsAuditId    String?
  correctedByAuditId String?
  metadata           Json            @default("{}")
  createdAt          DateTime        @default(now())
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([executionId])
  @@index([operationId])
}

model GmailConnection {
  id                     String       @id @default(cuid())
  organizationId         String
  userId                 String
  provider               String       @default("gmail")
  providerAccountId      String
  providerEmail          String?
  accessTokenEncrypted   String
  refreshTokenEncrypted  String?
  tokenExpiresAt         DateTime?
  grantedScopes          String
  status                 String       @default("CONNECTED")
  connectedAt            DateTime     @default(now())
  lastSuccessfulAccessAt DateTime?
  lastErrorAt            DateTime?
  lastErrorCode          String?
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([organizationId, userId, providerAccountId])
  @@index([organizationId, userId, status])
}

// Vendor-agnostic connection registry for Domain 28 (Entegrasyon) —
// provider is an open string (not an enum) so a new accounting vendor
// (e.g. Paraşüt) never needs a migration, only a new adapter in
// src/lib/integrations/. Org-scoped, not user-scoped: an accounting
// connection belongs to the business, not whoever set it up (unlike
// GmailConnection, which is per-user by design).
model IntegrationConnection {
  id                   String       @id @default(cuid())
  organizationId       String
  provider             String
  credentialsEncrypted String
  status               String       @default("CONNECTED")
  connectedAt          DateTime     @default(now())
  lastSuccessfulSyncAt DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

