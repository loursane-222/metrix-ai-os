  createdAt         DateTime               @default(now())

  @@index([organizationId, productionOrderId])
  @@index([productionOrderId, createdAt])
}

model ProductionOrderCustomFieldValue {
  id                String                @id @default(cuid())
  organizationId    String
  productionOrderId String
  definitionId      String
  valueJson         Json
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  definition        CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId, definitionId])
  @@index([organizationId, productionOrderId])
  @@index([organizationId, definitionId])
}

enum FieldVisitRequestType {
  DISPLAY_REQUEST
  SAMPLE_REQUEST
  OTHER
}

// Saha satış/pazarlama ziyaret günlüğü — bir temsilcinin tek bir serbest
// metin mesajla bildirdiği ziyareti (ve varsa bu ziyaretten doğan gerçek
// sipariş/tahsilatı) kayıt altına alır. CalendarEvent'ten kasıtlı olarak
// ayrı: burası "olmuş bir şeyin sonucu" kaydıdır, CalendarEvent ise
// "planlanmış bir zaman bloğu" — ikisini birleştirmek CalendarEvent'e bu
// domain'e özgü alanlar (requestTypesJson, unresolvedIntent, ilişkili
// sipariş/tahsilat) bulaştırırdı.
model FieldVisit {
  id               String                  @id @default(cuid())
  organizationId   String
  repUserId        String
  customerId       String?
  customerNameRaw  String
  contactNameRaw   String?
  startAt          DateTime
  endAt            DateTime?
  notes            String?
  requestTypesJson Json?
  unresolvedIntent String?
  relatedOrderId   String?
  relatedPaymentId String?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repUser          User         @relation(fields: [repUserId], references: [id], onDelete: Cascade)
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  relatedOrder     Order?       @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedPayment   Payment?     @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, repUserId, startAt])
  @@index([organizationId, customerId])
}
