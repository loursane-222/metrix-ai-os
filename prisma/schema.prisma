generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActionExecutionStatus {
  PENDING
  VERIFIED
}

enum LiveSessionStatus {
  BOOTSTRAPPING
  CONNECTED
  DISCONNECTED
  CLOSED
  FAILED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  customers        Customer[]
  tasks            Task[]
  actionExecutions ActionExecution[]
  liveSessions     LiveSession[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  timezone  String   @default("Europe/Istanbul")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   OrganizationMember[]
  sessions      Session[]
  tasksCreated  Task[]               @relation("TaskCreatedBy")
  tasksAssigned Task[]               @relation("TaskAssignedTo")
  liveSessions  LiveSession[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, name])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Task {
  id               String       @id @default(cuid())
  organizationId   String
  title            String
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(MEDIUM)
  dueAt            DateTime?
  createdByUserId  String?
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, dueAt])
}

model ActionExecution {
  id             String                @id @default(cuid())
  organizationId String
  actionType     String
  idempotencyKey String
  requestHash    String
  resourceType   String
  resourceId     String
  status         ActionExecutionStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  verifiedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actionType, idempotencyKey])
  @@index([organizationId, status])
  @@index([resourceType, resourceId])
}

model LiveSession {
  id                 String            @id @default(cuid())
  openAiSessionId    String?           @unique
  userId             String
  organizationId     String
  status             LiveSessionStatus @default(BOOTSTRAPPING)
  createdAt          DateTime          @default(now())
  connectedAt        DateTime?
  sidebandAttachedAt DateTime?
  endedAt            DateTime?
  failureCode        String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
