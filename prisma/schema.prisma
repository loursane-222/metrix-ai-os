// Phase 7 — Invoice'ın kendi gerçek line/item authority'si. Order/Quote gibi:
// productService/quantity/unitPriceCents/discountBasisPoints/vatRateBasisPoints
// aynı basis-points/cents konvansiyonunu (bkz. QuoteItem/OrderItem) izler.
// orderItemId yalnız Order-linked (createInvoiceFromOrder) satırlarda dolu
// olur; manuel/flat invoice'lar (createNewInvoice, lines'sız) hiç
// InvoiceItem üretmez — Invoice.amount/taxAmount/totalAmount o durumda
// bugünkü gibi çağıranın girdisinden gelir.
model InvoiceItem {
  id                  String          @id @default(cuid())
  organizationId      String
  invoiceId           String
  orderItemId         String?
  productServiceId    String?
  name                String
  unit                String?
  quantity            Decimal         @db.Decimal(14, 3)
  unitPriceCents      BigInt
  discountBasisPoints Int             @default(0)
  vatRateBasisPoints  Int             @default(0)
  lineTotalCents      BigInt
  sortOrder           Int             @default(0)
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice             Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem           OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productService      ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
  @@index([invoiceId, sortOrder])
  @@index([orderItemId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

