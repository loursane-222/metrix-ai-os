// Domain 26 canonical model — v1 scope (see enum comments above for what's
// deferred: parallel execution, dependency graphs, rollback/recovery,
// learning intelligence). One orchestration owns an ordered chain of steps,
// each step delegating to the existing, already-authorized Executive Action
// Engine (action-runtime) rather than reimplementing domain mutations here.
model ExecutiveOrchestration {
  id               String                  @id @default(cuid())
  organizationId   String
  triggerUtterance String
  triggerUserId    String?
  status           OrchestrationStatus     @default(PENDING)
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps            OrchestrationStep[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  completedAt      DateTime?

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model OrchestrationStep {
  id               String                    @id @default(cuid())
  orchestrationId  String
  organizationId   String
  sequence         Int
  domain           String
  actionName       String
  status           OrchestrationStepStatus   @default(PENDING)
  input            Json?
  resultEntityType String?
  resultEntityId   String?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  orchestration    ExecutiveOrchestration    @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@index([orchestrationId, sequence])
  @@index([organizationId])
}

// Domain 25 canonical model — v1 scope (see enum comments above for what's
// deferred: multi-channel, multi-audience, negotiation-tone intelligence,
// scheduled/deferred send). Every outbound message this domain owns is
// recorded here, grounded in real evidence (Evidence Policy §11 of the
// domain constitution) rather than freeform, unverified model output.
model ExecutiveCommunication {
  id                String                     @id @default(cuid())
  organizationId    String
  communicationType CommunicationType
  audienceType      CommunicationAudienceType
  customerId        String?
  channel           CommunicationChannel       @default(EMAIL)
  toneStrategy      CommunicationTone          @default(FRIENDLY)
  objective         String
  subject           String
  body              String
  recipientEmail    String
  status            CommunicationStatus
  providerMessageId String?
  errorMessage      String?
  evidenceRefs      Json?
  triggerUserId     String?
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())

  @@index([organizationId, communicationType])
  @@index([organizationId, customerId])
}

model BusinessCandidate {
  id                     String                              @id @default(cuid())
  propositionId          String
  organizationId         String
  conversationId         String?
  sourceChannel          BusinessCandidateSourceChannel
  sourceMessageId        String?
  sourceEventId          String?
  propositionType        String
  targetDomain           String
  targetRecordId         String?
  entityResolutionStatus String
  operation              BusinessCandidateOperation
  status                 BusinessCandidateStatus             @default(PROPOSED)
  confidence             Float?
  provenanceJson         Json
  requiresApproval       Boolean                             @default(true)
  verificationRequired   Boolean                             @default(false)
  idempotencyKey         String
  expiresAt              DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  promotedAt             DateTime?
  organization           Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changes                BusinessCandidateChange[]
  audits                 BusinessCandidateAudit[]
  promotionReceipts      BusinessCandidatePromotionReceipt[]
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, propositionId])
  @@index([organizationId, status])
  @@index([organizationId, targetDomain, targetRecordId])
  @@index([conversationId])
  @@index([sourceMessageId])
  @@index([expiresAt])
}

model BusinessCandidateChange {
  id                 String                              @id @default(cuid())
  candidateId        String
  fieldPath          String
  previousValue      Json?
  proposedValue      Json
  verificationStatus BusinessCandidateVerificationStatus @default(UNVERIFIED)
  conflictStatus     BusinessCandidateConflictStatus     @default(NONE)
  approvalStatus     BusinessCandidateApprovalStatus     @default(PENDING)
  candidate          BusinessCandidate                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt

  @@unique([candidateId, fieldPath])
  @@index([candidateId, approvalStatus])
}

model BusinessCandidateAudit {
  id             String                   @id @default(cuid())
  organizationId String
  candidateId    String
  fromStatus     BusinessCandidateStatus?
  toStatus       BusinessCandidateStatus
  actorUserId    String?
  reasonCode     String
  metadataJson   Json?
