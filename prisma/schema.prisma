generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActionExecutionStatus {
  PENDING
  VERIFIED
}

enum LiveSessionStatus {
  BOOTSTRAPPING
  CONNECTED
  DISCONNECTED
  CLOSED
  FAILED
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}

enum ProductServiceStatus {
  ACTIVE
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  WON
}

enum OrderStatus {
  DRAFT
}

enum InvoiceStatus {
  DRAFT
}

enum SettlementKind {
  ORIGINAL
  REVERSAL
}

enum MoneyDirection {
  IN
  OUT
}

enum LocationKind {
  WAREHOUSE
  STORE
  BRANCH
  PRODUCTION_AREA
}

// Canonical, closed set of quantity units. Deterministic validation only —
// no conversion arithmetic between units is ever performed (see
// commercial/unit-of-measure.ts). A new unit is an additive enum value.
enum UnitOfMeasure {
  PIECE
  KG
  G
  LITER
  ML
  M
  M2
  M3
  LINEAR_M
  HOUR
  NIGHT
}

enum PurchaseStatus {
  RECEIVED
}

enum InventoryMovementKind {
  PURCHASE_RECEIPT
  TRANSFER
  ADJUSTMENT
  TRANSFORMATION_CONSUME
  TRANSFORMATION_PRODUCE
}

enum InventoryDirection {
  IN
  OUT
}

enum TransformationLineRole {
  INPUT
  OUTPUT
  REMNANT
  SCRAP
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                OrganizationMember[]
  customers              Customer[]
  tasks                  Task[]
  actionExecutions       ActionExecution[]
  liveSessions           LiveSession[]
  productServices        ProductService[]
  quotes                 Quote[]
  quoteItems             QuoteItem[]
  executiveConversations ExecutiveConversation[]
  orders                 Order[]
  orderItems             OrderItem[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  payments               Payment[]
  settlements            Settlement[]
  applications           Application[]
  locations              Location[]
  suppliers              Supplier[]
  purchases              Purchase[]
  purchaseItems          PurchaseItem[]
  inventoryBalances      InventoryBalance[]
  inventoryMovements     InventoryMovement[]
  inventoryTransfers     InventoryTransfer[]
  transformations        Transformation[]
  transformationLines    TransformationLine[]
  externalSourceBindings ExternalSourceBinding[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  timezone  String   @default("Europe/Istanbul")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               OrganizationMember[]
  sessions                  Session[]
  tasksCreated              Task[]                  @relation("TaskCreatedBy")
  tasksAssigned             Task[]                  @relation("TaskAssignedTo")
  liveSessions              LiveSession[]
  createdQuotes             Quote[]                 @relation("QuoteCreatedBy")
  executiveConversations    ExecutiveConversation[]
  createdOrders             Order[]                 @relation("OrderCreatedBy")
  createdInvoices           Invoice[]               @relation("InvoiceCreatedBy")
  recordedSettlements       Settlement[]            @relation("SettlementActor")
  createdPurchases          Purchase[]              @relation("PurchaseCreatedBy")
  createdInventoryTransfers InventoryTransfer[]     @relation("InventoryTransferCreatedBy")
  createdTransformations    Transformation[]        @relation("TransformationCreatedBy")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes       Quote[]
  orders       Order[]
  invoices     Invoice[]
  payments     Payment[]

  @@unique([organizationId, externalId])
  @@index([organizationId, name])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Task {
  id               String       @id @default(cuid())
  organizationId   String
  title            String
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(MEDIUM)
  dueAt            DateTime?
  createdByUserId  String?
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, dueAt])
}

model ActionExecution {
  id             String                @id @default(cuid())
  organizationId String
  actionType     String
  idempotencyKey String
  requestHash    String
  resourceType   String
  resourceId     String
  status         ActionExecutionStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  verifiedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actionType, idempotencyKey])
  @@index([organizationId, status])
  @@index([resourceType, resourceId])
}

model ProductService {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  type           ProductServiceType
  category       String?
  unit           String?
  // Canonical deterministic unit for inventory quantity validation.
  // Nullable: existing/commercial-only ProductService rows never set this
  // and are wholly unaffected. The first inventory-affecting action
  // (purchase-record.ts) that names a unit materializes it here; every
  // later inventory action for this resource must match exactly, or it
  // fails closed — no silent conversion (see commercial/unit-of-measure.ts).
  unitOfMeasure  UnitOfMeasure?
  costCents      BigInt?
  priceCents     BigInt?
  currency       String               @default("TRY")
  status         ProductServiceStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteItems          QuoteItem[]
  orderItems          OrderItem[]
  invoiceItems        InvoiceItem[]
  purchaseItems       PurchaseItem[]
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  inventoryTransfers  InventoryTransfer[]
  transformationLines TransformationLine[]

  @@index([organizationId, status])
  @@index([organizationId, name])
}

model Quote {
  id                         String      @id @default(cuid())
  organizationId             String
  customerId                 String
  customerName               String
  title                      String
  amount                     Decimal?    @db.Decimal(14, 2)
  currency                   String      @default("TRY")
  status                     QuoteStatus @default(DRAFT)
  notes                      String?
  customerNote               String?
  specialTerms               String?
  validUntil                 DateTime?
  generalDiscountBasisPoints Int?
  deliveryTerm               String?
  deliveryMethod             String?
  idempotencyKey             String?
  requestHash                String?
  createdByUserId            String?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         QuoteItem[]
  orders        Order[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model QuoteItem {
  id                  String   @id @default(cuid())
  organizationId      String
  quoteId             String
  productServiceId    String?
  name                String
  unit                String?
  quantity            Decimal  @db.Decimal(14, 3)
  unitPriceCents      BigInt
  discountBasisPoints Int      @default(0)
  vatRateBasisPoints  Int      @default(0)
  lineTotalCents      BigInt
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([quoteId, sortOrder])
}

model Order {
  id                         String      @id @default(cuid())
  organizationId             String
  customerId                 String
  sourceQuoteId              String
  orderNumber                String
  customerName               String
  title                      String
  amount                     Decimal?    @db.Decimal(14, 2)
  currency                   String      @default("TRY")
  status                     OrderStatus @default(DRAFT)
  generalDiscountBasisPoints Int?
  deliveryTerm               String?
  deliveryMethod             String?
  notes                      String?
  createdByUserId            String?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceQuote   Quote        @relation(fields: [sourceQuoteId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  invoices      Invoice[]

  @@unique([organizationId, sourceQuoteId])
  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model OrderItem {
  id                  String   @id @default(cuid())
  organizationId      String
  orderId             String
  productServiceId    String?
  name                String
  unit                String?
  quantity            Decimal  @db.Decimal(14, 3)
  unitPriceCents      BigInt
  discountBasisPoints Int      @default(0)
  vatRateBasisPoints  Int      @default(0)
  lineTotalCents      BigInt
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  invoiceItems   InvoiceItem[]

  @@index([organizationId])
  @@index([orderId, sortOrder])
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  customerId      String
  sourceOrderId   String
  invoiceNumber   String
  title           String
  amount          Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  currency        String        @default("TRY")
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceOrder   Order         @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  createdByUser User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, sourceOrderId])
}

model InvoiceItem {
  id                  String   @id @default(cuid())
  organizationId      String
  invoiceId           String
  orderItemId         String
  productServiceId    String?
  name                String
  unit                String?
  quantity            Decimal  @db.Decimal(14, 3)
  unitPriceCents      BigInt
  discountBasisPoints Int      @default(0)
  vatRateBasisPoints  Int      @default(0)
  lineTotalCents      BigInt
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invoiceId, sortOrder])
  @@index([orderItemId])
}

// Receivable authority for one Invoice. Task 17 policy materializes at most
// one Payment per Invoice (see collection-record.ts), but invoiceId is
// deliberately NOT unique here — a future payment-terms/installment model
// may need more than one Payment per Invoice, and that is a schema-level
// door this Task must not close. The current one-per-invoice behavior is
// enforced by row-level locking on Invoice, the same technique Task 16 uses
// for Order -> Invoice (see invoice-create-from-order.ts).
model Payment {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  invoiceId      String
  title          String
  amount         Decimal   @db.Decimal(14, 2)
  currency       String
  paidAmount     Decimal   @default(0) @db.Decimal(14, 2)
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  settlements  Settlement[]
  applications Application[]

  @@index([organizationId, invoiceId])
  @@index([organizationId, customerId])
}

// Real customer collection event authority. Append-only: Task 17 only ever
// creates ORIGINAL/IN rows. reversalOfId is reserved for a future REVERSAL
// capability (not implemented in this Task) and must never be mutated after
// creation.
model Settlement {
  id             String         @id @default(cuid())
  organizationId String
  paymentId      String
  kind           SettlementKind @default(ORIGINAL)
  direction      MoneyDirection @default(IN)
  amount         Decimal        @db.Decimal(14, 2)
  currency       String
  occurredAt     DateTime
  idempotencyKey String?
  requestHash    String?
  actorUserId    String?
  reversalOfId   String?
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actorUser    User?         @relation("SettlementActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reversalOf   Settlement?   @relation("SettlementReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    Settlement[]  @relation("SettlementReversal")
  applications Application[]

  @@index([organizationId, paymentId])
  @@index([organizationId, occurredAt])
}

// Allocation/balance evidence linking a Settlement to the Payment it pays
// down. netCollected for a Payment is deterministically
// SUM(Application.amount WHERE kind=ORIGINAL) - SUM(... WHERE kind=REVERSAL);
// Task 17 only ever creates ORIGINAL rows.
model Application {
  id             String         @id @default(cuid())
  organizationId String
  settlementId   String
  paymentId      String
  kind           SettlementKind @default(ORIGINAL)
  amount         Decimal        @db.Decimal(14, 2)
  currency       String
  appliedAt      DateTime
  reversalOfId   String?
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlement   Settlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reversalOf   Application?  @relation("ApplicationReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    Application[] @relation("ApplicationReversal")

  @@index([organizationId, paymentId])
  @@index([organizationId, settlementId])
}

// Organization-scoped operational location authority (warehouse, store,
// branch, production area). Physical stock/balance is always scoped to a
// Location — there is no "global" stock.
model Location {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  kind           LocationKind
  externalId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  transfersFrom      InventoryTransfer[] @relation("InventoryTransferFrom")
  transfersTo        InventoryTransfer[] @relation("InventoryTransferTo")
  transformations    Transformation[]
  purchases          Purchase[]

  @@unique([organizationId, externalId])
  @@index([organizationId, kind])
  @@index([organizationId, name])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases    Purchase[]

  @@unique([organizationId, externalId])
  @@index([organizationId, name])
}

// "Kimden, ne kadar, hangi birim maliyetle ne aldık ve hangi lokasyona ne
// girdi?" truth. Deterministically produces one PURCHASE_RECEIPT/IN
// InventoryMovement (and balance update) per PurchaseItem, all in one
// transaction. No accounts-payable/settlement/expense semantics here —
// that is Operation 2 scope.
model Purchase {
  id              String         @id @default(cuid())
  organizationId  String
  supplierId      String
  locationId      String
  purchaseNumber  String
  status          PurchaseStatus @default(RECEIVED)
  currency        String         @default("TRY")
  totalCostCents  BigInt
  notes           String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdByUser User?          @relation("PurchaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         PurchaseItem[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, supplierId])
  @@index([organizationId, locationId])
}

model PurchaseItem {
  id               String   @id @default(cuid())
  organizationId   String
  purchaseId       String
  productServiceId String
  quantity         Decimal  @db.Decimal(14, 3)
  unitCostCents    BigInt
  lineTotalCents   BigInt
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase       Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productService ProductService @relation(fields: [productServiceId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([purchaseId, sortOrder])
}

// Deterministic current projection of on-hand quantity for one
// (ProductService, Location) pair. Always recomputed from/cross-verified
// against the InventoryMovement evidence aggregate on every mutation's
// verified readback — never the sole source of truth by itself, exactly
// like Payment.paidAmount in the commercial kernel.
model InventoryBalance {
  id               String   @id @default(cuid())
  organizationId   String
  productServiceId String
  locationId       String
  quantity         Decimal  @default(0) @db.Decimal(14, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productService ProductService @relation(fields: [productServiceId], references: [id], onDelete: Restrict)
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, productServiceId, locationId])
  @@index([organizationId, locationId])
}

// Append-only stock evidence. kind+direction together carry the full
// semantics (e.g. TRANSFER+OUT at the source location, TRANSFER+IN at the
// destination), the same kind/direction pattern Settlement already uses
// for money. sourceType/sourceId is a generic reference to the Purchase /
// InventoryTransfer / Transformation that caused this movement — the same
// generic-reference technique ActionExecution already uses.
model InventoryMovement {
  id               String                @id @default(cuid())
  organizationId   String
  productServiceId String
  locationId       String
  kind             InventoryMovementKind
  direction        InventoryDirection
  quantity         Decimal               @db.Decimal(14, 3)
  occurredAt       DateTime
  sourceType       String
  sourceId         String
  createdAt        DateTime              @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productService ProductService @relation(fields: [productServiceId], references: [id], onDelete: Restrict)
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([organizationId, productServiceId, locationId])
  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, occurredAt])
}

// One atomic stock move between two Locations for one ProductService.
// Always produces exactly two InventoryMovement rows (TRANSFER/OUT at
// fromLocation, TRANSFER/IN at toLocation) in a single transaction.
model InventoryTransfer {
  id               String   @id @default(cuid())
  organizationId   String
  productServiceId String
  fromLocationId   String
  toLocationId     String
  quantity         Decimal  @db.Decimal(14, 3)
  occurredAt       DateTime
  createdByUserId  String?
  createdAt        DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productService ProductService @relation(fields: [productServiceId], references: [id], onDelete: Restrict)
  fromLocation   Location       @relation("InventoryTransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     Location       @relation("InventoryTransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  createdByUser  User?          @relation("InventoryTransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, productServiceId])
  @@index([organizationId, fromLocationId])
  @@index([organizationId, toLocationId])
}

// Minimum deterministic transformation authority: input resource/quantity
// -> output resource/quantity (+ optional remnant/scrap), all at one
// Location, all in one transaction. The same primitive represents a
// marble slab -> countertop + reusable remnant + scrap AND a
// coffee/milk/cup -> sellable portion — no recipe/MRP/manufacturing suite.
model Transformation {
  id              String   @id @default(cuid())
  organizationId  String
  locationId      String
  title           String
  occurredAt      DateTime
  createdByUserId String?
  createdAt       DateTime @default(now())

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location      Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdByUser User?                @relation("TransformationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines         TransformationLine[]

  @@index([organizationId, locationId])
}

// role=INPUT/OUTPUT/REMNANT lines each produce one InventoryMovement
// (CONSUME/OUT for INPUT, PRODUCE/IN for OUTPUT and REMNANT — a reusable
// remnant is just usable stock of some ProductService). role=SCRAP is
// evidence-only: recorded here for audit/explainability but deliberately
// produces NO InventoryMovement, since waste is not held inventory.
model TransformationLine {
  id               String                 @id @default(cuid())
  organizationId   String
  transformationId String
  productServiceId String
  role             TransformationLineRole
  quantity         Decimal                @db.Decimal(14, 3)
  sortOrder        Int                    @default(0)
  createdAt        DateTime               @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transformation Transformation @relation(fields: [transformationId], references: [id], onDelete: Cascade)
  productService ProductService @relation(fields: [productServiceId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([transformationId, sortOrder])
}

// Minimum provenance/identity-mapping for Company Truth records that
// originate from an external system (POS/ERP/CRM/MCP connector etc.).
// resourceType/resourceId is the same generic-reference technique
// ActionExecution already uses — deliberately NOT a generic EAV/ontology
// engine. The unique constraint on (organizationId, sourceSystem,
// externalId) is what makes external identity resolution fail-closed: a
// second attempt to bind the same external identity to a different
// resource is rejected by the database, not silently overwritten.
model ExternalSourceBinding {
  id             String    @id @default(cuid())
  organizationId String
  resourceType   String
  resourceId     String
  sourceSystem   String
  externalId     String
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, resourceType, resourceId])
}

model LiveSession {
  id                 String            @id @default(cuid())
  openAiSessionId    String?           @unique
  userId             String
  organizationId     String
  status             LiveSessionStatus @default(BOOTSTRAPPING)
  createdAt          DateTime          @default(now())
  connectedAt        DateTime?
  sidebandAttachedAt DateTime?
  endedAt            DateTime?
  failureCode        String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ExecutiveConversation {
  id                   String   @id @default(cuid())
  organizationId       String
  userId               String
  openAiConversationId String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
}
