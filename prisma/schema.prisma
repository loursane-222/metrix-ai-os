  candidate          BusinessCandidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt          DateTime                         @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([candidateId, writtenAt])
  @@index([organizationId, executionId])
}

model ExecutiveRuntimeTraceRecord {
