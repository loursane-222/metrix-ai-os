model ActionApproval {
  id                  String                  @id @default(uuid())
  organizationId      String
  actorUserId         String
  actionName          String
  targetEntityType    String?
  targetEntityId      String?
  normalizedInputHash String
  riskLevel           String
  status              ActionApprovalStatus    @default(PENDING)
  requestedAt         DateTime                @default(now())
  expiresAt           DateTime
  decidedAt           DateTime?
  decidedByUserId     String?
  decision            ActionApprovalDecision?
  decisionReason      String?
  consumedAt          DateTime?
  correlationId       String
  idempotencyKey      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor               User                    @relation("ActionApprovalActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  decidedBy           User?                   @relation("ActionApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([organizationId, actorUserId, idempotencyKey])
  @@index([organizationId, actorUserId, status])
  @@index([organizationId, actionName, targetEntityType, targetEntityId])
  @@index([expiresAt])
}

