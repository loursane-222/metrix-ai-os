// Domain 26 — Yönetici Orkestrasyon Motoru. Sequential execution of an
// ordered step list. A chain that fails midway is never left half-done:
// COMPENSATING/COMPENSATED/COMPENSATION_FAILED cover the reverse-order undo
// pass over already-COMPLETED steps (see runCompensationPass in
// executive-orchestration.service.ts). PARTIALLY_COMPLETED is retained only
// for rows written before compensation existed — no code path writes it
// anymore.
enum OrchestrationStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  COMPENSATING
  COMPENSATED
  COMPENSATION_FAILED
}

enum OrchestrationStepStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  SKIPPED
  COMPENSATING
  COMPENSATED
  COMPENSATION_FAILED
  COMPENSATION_AWAITING_APPROVAL
}

// Domain 25 — Yönetici İletişim Motoru. v1 scope: one canonical outbound
// type (payment reminder), one audience (customer), one channel (email).
// SUPPLIER_MESSAGE (B3, 2026-08-24) adds a second, deliberately different
// kind: PAYMENT_REMINDER auto-composes its content from canonical evidence
// (a real balance) per the domain's Evidence Policy; SUPPLIER_MESSAGE's
// content is instead dictated verbatim by the user in their own words —
// nothing is claimed or synthesized about the supplier, so the evidence
// policy doesn't apply the same way (there is nothing to fabricate).
// See executive-communication.service.ts for what's still deliberately deferred.
enum CommunicationType {
  PAYMENT_REMINDER
  SUPPLIER_MESSAGE
}

enum CommunicationAudienceType {
  CUSTOMER
  SUPPLIER
