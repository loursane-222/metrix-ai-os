  DONE
  DISMISSED
}

enum CollectionActionType {
  CALL
  MEETING
  LEGAL_NOTICE
  REMINDER
  NEGOTIATION
  FOLLOW_UP
}

enum CollectionActionSource {
  AI_SUGGESTED
  USER_CREATED
}

enum ExecutiveActionStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
  CANCELLED
}

enum ExecutiveActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutiveActionOutcomeStatus {
  SUCCESS
  PARTIAL
  FAILED
  UNKNOWN
}

enum ExecutiveActionSourceType {
  EXECUTIVE_PRIORITY
  DAILY_BRIEFING
  MANAGEMENT_REVIEW
  PERFORMANCE_SIGNAL
  CUSTOMER_SIGNAL
  DECISION
  MANUAL
}

enum ExecutiveActionOwnerType {
  USER
  PERSON
  METRIX
  UNASSIGNED
}

// Domain 26 — Yönetici Orkestrasyon Motoru. v1 scope: sequential-only
// execution of an ordered step list. PARTIALLY_COMPLETED covers a chain
// that fails midway with earlier steps already committed — those earlier
// steps are never rolled back (no compensation/rollback intelligence yet,
// see executive-orchestration.service.ts for what's deliberately deferred).
enum OrchestrationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum OrchestrationStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

// Domain 25 — Yönetici İletişim Motoru. v1 scope: one canonical outbound
// type (payment reminder), one audience (customer), one channel (email).
// See executive-communication.service.ts for what's deliberately deferred.
enum CommunicationType {
  PAYMENT_REMINDER
}

enum CommunicationAudienceType {
  CUSTOMER
}

enum CommunicationTone {
  FRIENDLY
  FORMAL
  DIRECT
}

enum CommunicationChannel {
  EMAIL
}

enum CommunicationStatus {
  SENT
  FAILED
}

enum CollectionActionEventType {
  ACTION_CREATED
  STATUS_CHANGED
  CONTACT_LOGGED
  PAYMENT_PROMISED
  PAYMENT_DATE_SET
  PAYMENT_CONFIRMED
  NOTE_ADDED
}

enum ExecutiveDecisionRecordSourceType {
  EXECUTIVE_BRAIN
  ALERT
  FORECAST_SIGNAL
  RHYTHM
}

enum ExecutiveDecisionRecordStatus {
  PROPOSED
  COMMITTED
  REJECTED
  CLOSED
}

enum ExecutiveDecisionOutcomeType {
  SUCCESS
  FAILURE
  ABANDONED
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseRecurrenceType {
  ONCE
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ExpenseCategory {
  PAYROLL
  RENT
  UTILITIES
  SOFTWARE
  MARKETING
  TAX
  SUPPLIER
  LOGISTICS
  OTHER
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

enum LedgerSourceType {
