generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActionExecutionStatus {
  PENDING
  VERIFIED
}

enum LiveSessionStatus {
  BOOTSTRAPPING
  CONNECTED
  DISCONNECTED
  CLOSED
  FAILED
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}

enum ProductServiceStatus {
  ACTIVE
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  WON
}

enum OrderStatus {
  DRAFT
}

enum InvoiceStatus {
  DRAFT
}

enum SettlementKind {
  ORIGINAL
  REVERSAL
}

enum MoneyDirection {
  IN
  OUT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               OrganizationMember[]
  customers             Customer[]
  tasks                 Task[]
  actionExecutions      ActionExecution[]
  liveSessions          LiveSession[]
  productServices       ProductService[]
  quotes                Quote[]
  quoteItems            QuoteItem[]
  executiveConversations ExecutiveConversation[]
  orders                Order[]
  orderItems            OrderItem[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  payments              Payment[]
  settlements           Settlement[]
  applications          Application[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  timezone  String   @default("Europe/Istanbul")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            OrganizationMember[]
  sessions               Session[]
  tasksCreated           Task[]                  @relation("TaskCreatedBy")
  tasksAssigned          Task[]                  @relation("TaskAssignedTo")
  liveSessions           LiveSession[]
  createdQuotes          Quote[]                 @relation("QuoteCreatedBy")
  executiveConversations ExecutiveConversation[]
  createdOrders          Order[]                 @relation("OrderCreatedBy")
  createdInvoices        Invoice[]               @relation("InvoiceCreatedBy")
  recordedSettlements    Settlement[]            @relation("SettlementActor")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes       Quote[]
  orders       Order[]
  invoices     Invoice[]
  payments     Payment[]

  @@unique([organizationId, externalId])
  @@index([organizationId, name])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Task {
  id               String       @id @default(cuid())
  organizationId   String
  title            String
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(MEDIUM)
  dueAt            DateTime?
  createdByUserId  String?
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, dueAt])
}

model ActionExecution {
  id             String                @id @default(cuid())
  organizationId String
  actionType     String
  idempotencyKey String
  requestHash    String
  resourceType   String
  resourceId     String
  status         ActionExecutionStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  verifiedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actionType, idempotencyKey])
  @@index([organizationId, status])
  @@index([resourceType, resourceId])
}

model ProductService {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  type           ProductServiceType
  category       String?
  unit           String?
  costCents      BigInt?
  priceCents     BigInt?
  currency       String               @default("TRY")
  status         ProductServiceStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteItems   QuoteItem[]
  orderItems   OrderItem[]
  invoiceItems InvoiceItem[]

  @@index([organizationId, status])
  @@index([organizationId, name])
}

model Quote {
  id                         String       @id @default(cuid())
  organizationId             String
  customerId                 String
  customerName               String
  title                      String
  amount                     Decimal?     @db.Decimal(14, 2)
  currency                   String       @default("TRY")
  status                     QuoteStatus  @default(DRAFT)
  notes                      String?
  customerNote               String?
  specialTerms               String?
  validUntil                 DateTime?
  generalDiscountBasisPoints Int?
  deliveryTerm               String?
  deliveryMethod             String?
  idempotencyKey             String?
  requestHash                String?
  createdByUserId            String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         QuoteItem[]
  orders        Order[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model QuoteItem {
  id                  String          @id @default(cuid())
  organizationId      String
  quoteId             String
  productServiceId    String?
  name                String
  unit                String?
  quantity            Decimal         @db.Decimal(14, 3)
  unitPriceCents      BigInt
  discountBasisPoints Int             @default(0)
  vatRateBasisPoints  Int             @default(0)
  lineTotalCents      BigInt
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([quoteId, sortOrder])
}

model Order {
  id                         String      @id @default(cuid())
  organizationId             String
  customerId                 String
  sourceQuoteId              String
  orderNumber                String
  customerName               String
  title                      String
  amount                     Decimal?    @db.Decimal(14, 2)
  currency                   String      @default("TRY")
  status                     OrderStatus @default(DRAFT)
  generalDiscountBasisPoints Int?
  deliveryTerm               String?
  deliveryMethod             String?
  notes                      String?
  createdByUserId            String?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceQuote   Quote        @relation(fields: [sourceQuoteId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  invoices      Invoice[]

  @@unique([organizationId, sourceQuoteId])
  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model OrderItem {
  id                  String          @id @default(cuid())
  organizationId      String
  orderId             String
  productServiceId    String?
  name                String
  unit                String?
  quantity            Decimal         @db.Decimal(14, 3)
  unitPriceCents      BigInt
  discountBasisPoints Int             @default(0)
  vatRateBasisPoints  Int             @default(0)
  lineTotalCents      BigInt
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  invoiceItems   InvoiceItem[]

  @@index([organizationId])
  @@index([orderId, sortOrder])
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  customerId      String
  sourceOrderId   String
  invoiceNumber   String
  title           String
  amount          Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  currency        String        @default("TRY")
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceOrder   Order         @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  createdByUser User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, sourceOrderId])
}

model InvoiceItem {
  id                  String          @id @default(cuid())
  organizationId      String
  invoiceId           String
  orderItemId         String
  productServiceId    String?
  name                String
  unit                String?
  quantity            Decimal         @db.Decimal(14, 3)
  unitPriceCents      BigInt
  discountBasisPoints Int             @default(0)
  vatRateBasisPoints  Int             @default(0)
  lineTotalCents      BigInt
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invoiceId, sortOrder])
  @@index([orderItemId])
}

// Receivable authority for one Invoice. Task 17 policy materializes at most
// one Payment per Invoice (see collection-record.ts), but invoiceId is
// deliberately NOT unique here — a future payment-terms/installment model
// may need more than one Payment per Invoice, and that is a schema-level
// door this Task must not close. The current one-per-invoice behavior is
// enforced by row-level locking on Invoice, the same technique Task 16 uses
// for Order -> Invoice (see invoice-create-from-order.ts).
model Payment {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  invoiceId      String
  title          String
  amount         Decimal   @db.Decimal(14, 2)
  currency       String
  paidAmount     Decimal   @default(0) @db.Decimal(14, 2)
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  settlements  Settlement[]
  applications Application[]

  @@index([organizationId, invoiceId])
  @@index([organizationId, customerId])
}

// Real customer collection event authority. Append-only: Task 17 only ever
// creates ORIGINAL/IN rows. reversalOfId is reserved for a future REVERSAL
// capability (not implemented in this Task) and must never be mutated after
// creation.
model Settlement {
  id             String         @id @default(cuid())
  organizationId String
  paymentId      String
  kind           SettlementKind @default(ORIGINAL)
  direction      MoneyDirection @default(IN)
  amount         Decimal        @db.Decimal(14, 2)
  currency       String
  occurredAt     DateTime
  idempotencyKey String?
  requestHash    String?
  actorUserId    String?
  reversalOfId   String?
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actorUser    User?         @relation("SettlementActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reversalOf   Settlement?   @relation("SettlementReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    Settlement[]  @relation("SettlementReversal")
  applications Application[]

  @@index([organizationId, paymentId])
  @@index([organizationId, occurredAt])
}

// Allocation/balance evidence linking a Settlement to the Payment it pays
// down. netCollected for a Payment is deterministically
// SUM(Application.amount WHERE kind=ORIGINAL) - SUM(... WHERE kind=REVERSAL);
// Task 17 only ever creates ORIGINAL rows.
model Application {
  id             String        @id @default(cuid())
  organizationId String
  settlementId   String
  paymentId      String
  kind           SettlementKind @default(ORIGINAL)
  amount         Decimal       @db.Decimal(14, 2)
  currency       String
  appliedAt      DateTime
  reversalOfId   String?
  createdAt      DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlement   Settlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reversalOf   Application?  @relation("ApplicationReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    Application[] @relation("ApplicationReversal")

  @@index([organizationId, paymentId])
  @@index([organizationId, settlementId])
}

model LiveSession {
  id                 String            @id @default(cuid())
  openAiSessionId    String?           @unique
  userId             String
  organizationId     String
  status             LiveSessionStatus @default(BOOTSTRAPPING)
  createdAt          DateTime          @default(now())
  connectedAt        DateTime?
  sidebandAttachedAt DateTime?
  endedAt            DateTime?
  failureCode        String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ExecutiveConversation {
  id                   String   @id @default(cuid())
  organizationId       String
  userId               String
  openAiConversationId String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
}
