  SERVICE
}

enum ProductServiceStatus {
  ACTIVE
  PASSIVE
  ARCHIVED
}

enum SalesGoalPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum SalesGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ActionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  CONSUMED
}

enum ActionApprovalDecision {
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                            String                       @id @default(uuid())
  phone                         String                       @unique
  fullName                      String?
  email                         String?
  avatarUrl                     String?
  timezone                      String                       @default("Europe/Istanbul")
  language                      String                       @default("tr")
  lastActiveAt                  DateTime?
  onboardingStatus              OnboardingStatus             @default(NOT_STARTED)
  onboardingStep                String?                      @default("WELCOME")
  onboardingCompletedAt         DateTime?
  memberships                   OrganizationMember[]
  messages                      Message[]
  events                        Event[]
  createdMemoryItems            MemoryItem[]                 @relation("MemoryItemCreatedBy")
  deletedMemoryItems            MemoryItem[]                 @relation("MemoryItemDeletedBy")
  createdMemoryCandidates       MemoryCandidate[]            @relation("MemoryCandidateCreatedBy")
  reviewedMemoryCandidates      MemoryCandidate[]            @relation("MemoryCandidateReviewedBy")
  sessions                      Session[]
  trustedDevices                TrustedDevice[]
  gmailConnections              GmailConnection[]
  createdCustomers              Customer[]                   @relation("CustomerCreatedBy")
  updatedCustomers              Customer[]                   @relation("CustomerUpdatedBy")
  createdCustomFieldDefinitions CustomFieldDefinition[]      @relation("CustomFieldCreatedBy")
  customerDocumentAttachments   CustomerDocumentAttachment[]
  requestedActionApprovals      ActionApproval[]             @relation("ActionApprovalActor")
  decidedActionApprovals        ActionApproval[]             @relation("ActionApprovalDecider")
  notifications                 Notification[]               @relation("NotificationRecipient")
  assignedTasks                 Task[]                       @relation("TaskAssignee")
  createdTasks                  Task[]                       @relation("TaskCreatedBy")
  uploadedDocuments              Document[]
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt

  @@index([phone])
}

model Organization {
  id                          String                              @id @default(uuid())
  name                        String
  industry                    String?
  companySize                 String?
  country                     String?                             @default("TR")
  city                        String?
  description                 String?
  onboardingStatus            OnboardingStatus                    @default(NOT_STARTED)
  onboardingStep              String?                             @default("WELCOME")
  businessProfileJson         Json?
  recognitionProfileJson      Json?
  onboardingCompletedAt       DateTime?
  members                     OrganizationMember[]
  conversations               Conversation[]
  events                      Event[]
  memories                    Memory[]
  memoryItems                 MemoryItem[]
  memoryCandidates            MemoryCandidate[]
  people                      Person[]
  quotes                      Quote[]
  quoteItems                  QuoteItem[]
  payments                    Payment[]
  collectionActions           CollectionAction[]
  collectionActionEvents      CollectionActionEvent[]
  quoteEvents                 QuoteEvent[]
  quoteCounterProposals       QuoteCounterProposal[]
  aiSuggestions               AiSuggestion[]
  signalSnapshots             ExecutiveSignalSnapshot[]
  executiveDecisionRecords    ExecutiveDecisionRecord[]
  executiveDecisionOutcomes   ExecutiveDecisionOutcome[]
  executiveActions            ExecutiveAction[]
  executiveOrchestrations     ExecutiveOrchestration[]
  executiveCommunications     ExecutiveCommunication[]
  expenses                    Expense[]
  customers                   Customer[]
  customerContacts            CustomerContact[]
  customFieldDefinitions      CustomFieldDefinition[]
  customerCustomFieldValues   CustomerCustomFieldValue[]
  suppliers                   Supplier[]
  supplierContacts            SupplierContact[]
  supplierProducts            SupplierProduct[]
  supplierContracts           SupplierContract[]
  supplierCustomFieldValues   SupplierCustomFieldValue[]
  customerCommercialTerms     CustomerCommercialTerms[]
  customerDocumentAttachments CustomerDocumentAttachment[]
  productServices             ProductService[]
  salesGoals                  SalesGoal[]
  gmailConnections            GmailConnection[]
  actionApprovals             ActionApproval[]
  businessCandidates          BusinessCandidate[]
  businessCandidateAudits     BusinessCandidateAudit[]
  businessCandidateReceipts   BusinessCandidatePromotionReceipt[]
  executiveRuntimeTraces      ExecutiveRuntimeTraceRecord[]
  executiveMindRuntimeState   ExecutiveMindRuntimeStateRecord?
  companyProfile              CompanyProfile?
  companyUnits                CompanyUnit[]
  companyDynamicFieldValues   CompanyDynamicFieldValue[]
  companyDataSources          CompanyDataSource[]
  companyAssets               CompanyAsset[]
  kpiDefinitions              KpiDefinition[]
  reportTemplates             ReportTemplate[]
  reportAssignments           ReportAssignment[]
  reportSubmissions           ReportSubmission[]
  notifications               Notification[]
  tasks                       Task[]
  invoices                    Invoice[]
  ledgerEntries               LedgerEntry[]
  orders                      Order[]
  orderItems                  OrderItem[]
  orderStatusHistories        OrderStatusHistory[]
  orderRevisions              OrderRevision[]
  orderExceptions             OrderException[]
  orderCustomFieldValues      OrderCustomFieldValue[]
  deliveries                  Delivery[]
  deliveryItems               DeliveryItem[]
  deliveryStatusHistories     DeliveryStatusHistory[]
  deliveryExceptions          DeliveryException[]
  deliveryCustomFieldValues   DeliveryCustomFieldValue[]
  warehouses                  Warehouse[]
  stocks                      Stock[]
  stockMovements              StockMovement[]
  stockCountRecords           StockCountRecord[]
  stockCustomFieldValues      StockCustomFieldValue[]
  workCenters                 WorkCenter[]
  machines                    Machine[]
  productionOrders            ProductionOrder[]
  productionOrderStatusHistories ProductionOrderStatusHistory[]
  productionOrderCustomFieldValues ProductionOrderCustomFieldValue[]
  calendarEvents              CalendarEvent[]
  calendarEventParticipants   CalendarEventParticipant[]
  calendarEventStatusHistories CalendarEventStatusHistory[]
  documents                   Document[]
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt

  @@index([name])
  @@index([onboardingStatus])
}

model ActionApproval {
  id                  String                  @id @default(uuid())
  organizationId      String
  actorUserId         String
  actionName          String
  targetEntityType    String?
  targetEntityId      String?
  normalizedInputHash String
  riskLevel           String
  status              ActionApprovalStatus    @default(PENDING)
  requestedAt         DateTime                @default(now())
  expiresAt           DateTime
  decidedAt           DateTime?
  decidedByUserId     String?
  decision            ActionApprovalDecision?
  decisionReason      String?
  consumedAt          DateTime?
  correlationId       String
  idempotencyKey      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor               User                    @relation("ActionApprovalActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  decidedBy           User?                   @relation("ActionApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([organizationId, actorUserId, idempotencyKey])
  @@index([organizationId, actorUserId, status])
  @@index([organizationId, actionName, targetEntityType, targetEntityId])
  @@index([expiresAt])
}

model GmailConnection {
  id                     String       @id @default(cuid())
  organizationId         String
  userId                 String
  provider               String       @default("gmail")
  providerAccountId      String
  providerEmail          String?
  accessTokenEncrypted   String
  refreshTokenEncrypted  String?
  tokenExpiresAt         DateTime?
  grantedScopes          String
  status                 String       @default("CONNECTED")
  connectedAt            DateTime     @default(now())
  lastSuccessfulAccessAt DateTime?
  lastErrorAt            DateTime?
  lastErrorCode          String?
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([organizationId, userId, providerAccountId])
  @@index([organizationId, userId, status])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(OWNER)
  status         MemberStatus     @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEventParticipants CalendarEventParticipant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

model Conversation {
  id                          String                       @id @default(uuid())
  organizationId              String
  createdBy                   String?
  title                       String?
  type                        ConversationType             @default(GENERAL)
  status                      ConversationStatus           @default(OPEN)
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages                    Message[]
  customerDocumentAttachments CustomerDocumentAttachment[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  senderType     MessageSenderType
  senderId       String?
  content        String
  metadata       Json?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@index([senderType])
  @@index([senderId])
  @@index([createdAt])
}

model Event {
  id               String            @id @default(uuid())
  organizationId   String
  actorUserId      String?
  eventType        String
  entityType       String?
  entityId         String?
  payload          Json?
  source           EventSource       @default(SYSTEM)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor            User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  memories         Memory[]
  memoryItems      MemoryItem[]      @relation("MemoryItemSourceEvent")
  memoryCandidates MemoryCandidate[] @relation("MemoryCandidateSourceEvent")
  createdAt        DateTime          @default(now())

  @@index([organizationId])
  @@index([actorUserId])
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CustomerDocumentAttachment {
  id                  String        @id @default(uuid())
  organizationId      String
  actorUserId         String
  conversationId      String?
  filename            String
  mimeType            String
  sizeBytes           Int
  content             Bytes
  expiresAt           DateTime
  extractionStatus    String        @default("READY")
  extractionRequestId String?
  extractionPayload   Json?
  extractionErrorCode String?
  extractedAt         DateTime?
  reviewStatus        String        @default("PENDING")
  reviewPayload       Json?
  draftId             String?
  correlationId       String?
  commitExecutionId   String?
  committedCustomerId String?
  commitResult        Json?
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor               User          @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([organizationId, actorUserId, expiresAt])
  @@index([conversationId])
  @@index([expiresAt])
}

model Memory {
  id             String       @id @default(uuid())
  organizationId String
  sourceEventId  String?
  entityType     String?
  entityId       String?
  type           MemoryType
  title          String
  content        String
  importance     Int          @default(50)
  confidence     Int          @default(50)
  embedding      Json?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceEvent    Event?       @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([sourceEventId])
  @@index([entityType, entityId])
  @@index([type])
  @@index([importance])
}

model MemoryItem {
  id                 String            @id @default(cuid())
  organizationId     String
  createdByUserId    String?
  deletedByUserId    String?
  subjectType        MemorySubjectType
  subjectId          String?
  type               MemoryItemType
  key                String
  value              String
  source             MemoryItemSource
  confidence         Int               @default(100)
  status             MemoryItemStatus  @default(ACTIVE)
  isUserConfirmed    Boolean           @default(false)
  sourceEventId      String?
  sourceCandidateId  String?
  supersedesMemoryId String?
  metadata           Json?
  deletedAt          DateTime?
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser      User?             @relation("MemoryItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedByUser      User?             @relation("MemoryItemDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  sourceEvent        Event?            @relation("MemoryItemSourceEvent", fields: [sourceEventId], references: [id], onDelete: SetNull)
  sourceCandidate    MemoryCandidate?  @relation("MemoryItemSourceCandidate", fields: [sourceCandidateId], references: [id], onDelete: SetNull)
  supersedesMemory   MemoryItem?       @relation("MemoryItemSupersession", fields: [supersedesMemoryId], references: [id], onDelete: SetNull)
  supersededBy       MemoryItem[]      @relation("MemoryItemSupersession")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, key])
  @@index([organizationId, status, type])
  @@index([sourceCandidateId])
  @@index([supersedesMemoryId])
  @@index([deletedAt])
}

model MemoryCandidate {
  id               String                @id @default(cuid())
  organizationId   String
  createdByUserId  String?
  reviewedByUserId String?
  subjectType      MemorySubjectType
  subjectId        String?
  proposedType     MemoryItemType
  proposedKey      String
  proposedValue    String
  source           MemoryItemSource
  confidence       Int                   @default(70)
  isAssumption     Boolean               @default(true)
  reason           String
  evidenceJson     Json?
  metadata         Json?
  sourceEventId    String?
  sourceMessageId  String?
  status           MemoryCandidateStatus @default(PENDING)
  reviewedAt       DateTime?
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser    User?                 @relation("MemoryCandidateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedByUser   User?                 @relation("MemoryCandidateReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  sourceEvent      Event?                @relation("MemoryCandidateSourceEvent", fields: [sourceEventId], references: [id], onDelete: SetNull)
  memoryItems      MemoryItem[]          @relation("MemoryItemSourceCandidate")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, proposedType])
  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, proposedKey])
  @@index([reviewedAt])
}

model Person {
  id               String            @id @default(uuid())
  organizationId   String
  type             PersonType
  fullName         String
  title            String?
  phone            String?
  email            String?
  notes            String?
  metadata         Json?
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments         Payment[]
  quotes           Quote[]
  customerContacts CustomerContact[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([fullName])
  @@index([phone])
}

model Quote {
  id                         String       @id @default(uuid())
  organizationId             String
  personId                   String?
  customerId                 String?
  customerName               String
  title                      String
  amount                     Decimal?     @db.Decimal(14, 2)
  currency                   String       @default("TRY")
  status                     QuoteStatus  @default(DRAFT)
  sentAt                     DateTime?
  viewedAt                   DateTime?
  wonAt                      DateTime?
  lostAt                     DateTime?
  lostReason                 String?
  notes                      String?
  customerNote               String?
  specialTerms               String?
  validUntil                 DateTime?
  generalDiscountBasisPoints Int?
  paymentTerm                String?
  deliveryTerm               String?
  deliveryMethod             String?
  metadata                   Json?
  idempotencyKey             String?
  requestHash                String?
  publicTokenHash            String?      @unique
  publicTokenCreatedAt       DateTime?
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person                     Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  customer                   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments                   Payment[]
  invoices                   Invoice[]
  events                     QuoteEvent[]
  counterProposals           QuoteCounterProposal[]
  items                      QuoteItem[]
  orders                     Order[]
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, personId])
  @@index([organizationId, customerId])
  @@index([customerName])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id                  String          @id @default(cuid())
  organizationId      String
  quoteId             String
  productServiceId    String?
  name                String
  unit                String?
  quantity            Decimal         @db.Decimal(14, 3)
  unitPriceCents      BigInt
  discountBasisPoints Int             @default(0)
  vatRateBasisPoints  Int             @default(0)
  lineTotalCents      BigInt
  sortOrder           Int             @default(0)
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote               Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productService      ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([organizationId])
  @@index([quoteId])
  @@index([quoteId, sortOrder])
}

model QuoteEvent {
  id             String           @id @default(cuid())
  organizationId String
  quoteId        String
  conversationId String?
  eventType      QuoteEventType
  fromStatus     QuoteStatus?
  toStatus       QuoteStatus?
  note           String?
  source         QuoteEventSource @default(AI_SUGGESTED)
  metadata       Json?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([quoteId])
  @@index([organizationId, createdAt])
  @@index([quoteId, eventType])
}

