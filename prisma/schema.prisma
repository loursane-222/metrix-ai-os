// Domain 26 canonical model (see enum comments above for what's still
// deferred: parallel execution, dynamic dependency graphs, learning
// intelligence). One orchestration owns an ordered chain of steps, each
// step delegating to the existing, already-authorized Executive Action
// Engine (action-runtime) rather than reimplementing domain mutations here.
model ExecutiveOrchestration {
  id               String                  @id @default(cuid())
  organizationId   String
  triggerUtterance String
  triggerUserId    String?
  status           OrchestrationStatus     @default(PENDING)
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps            OrchestrationStep[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  completedAt      DateTime?

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model OrchestrationStep {
  id               String                    @id @default(cuid())
  orchestrationId  String
  organizationId   String
  sequence         Int
  domain           String
  actionName       String
  status           OrchestrationStepStatus   @default(PENDING)
  input            Json?
  approvalRequestId String?
  resultEntityType String?
  resultEntityId   String?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  // Pre-mutation "before" state captured at forward-execution time, read
  // back by runCompensationPass to build the reverse call. See
  // compensation.ts's deriveCompensationCalls for the contract: for a
  // self-compensating UPDATE action this is that action's own replay input;
  // for a CREATE→archive pair it's whatever raw facts the archive action's
  // compensator needs beyond resultEntityId.
  compensationSnapshot Json?
  compensatedAt    DateTime?
  orchestration    ExecutiveOrchestration    @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@index([orchestrationId, sequence])
  @@index([organizationId])
}

// Domain 25 canonical model — v1 scope (see enum comments above for what's
// deferred: multi-channel, multi-audience, negotiation-tone intelligence,
// scheduled/deferred send). Every outbound message this domain owns is
// recorded here, grounded in real evidence (Evidence Policy §11 of the
// domain constitution) rather than freeform, unverified model output.
model ExecutiveCommunication {
  id                String                     @id @default(cuid())
  organizationId    String
  communicationType CommunicationType
  audienceType      CommunicationAudienceType
  customerId        String?
  supplierId        String?
  channel           CommunicationChannel       @default(EMAIL)
  toneStrategy      CommunicationTone          @default(FRIENDLY)
  objective         String
  subject           String
  body              String
  recipientEmail    String
  status            CommunicationStatus
  providerMessageId String?
  errorMessage      String?
  evidenceRefs      Json?
  triggerUserId     String?
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier          Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())

  @@index([organizationId, communicationType])
  @@index([organizationId, customerId])
  @@index([organizationId, supplierId])
}

