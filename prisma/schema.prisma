model ProductionOrderStatusHistory {
  id                String                 @id @default(cuid())
  organizationId    String
  productionOrderId String
  fromStatus        ProductionOrderStatus?
  toStatus          ProductionOrderStatus
  reason            String?
  performedById     String?
