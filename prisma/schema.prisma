// ─── Order Domain (Sipariş) ───────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PLANNED
  IN_PRODUCTION
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum OrderRevisionChangeType {
  QUANTITY_CHANGED
  DEADLINE_CHANGED
  ITEM_ADDED
  ITEM_REMOVED
}

enum OrderExceptionCategory {
  CUSTOMER_HOLD_REQUEST
  PRODUCTION_STOPPED
  QUALITY_ISSUE
  SUPPLY_DELAY
  PAYMENT_HOLD
  SHIPMENT_DELAYED
  CUSTOMER_ADDRESS_CHANGED
  OTHER
}

model Order {
  id                    String                  @id @default(cuid())
  organizationId        String
  orderNumber           String
  customerId            String
  sourceQuoteId         String?
  status                OrderStatus             @default(DRAFT)
  priority              Int                     @default(0)
  deadlineAt            DateTime?
  commitmentAt          DateTime?
  currency              String                  @default("TRY")
  notes                 String?
  cancellationReason    String?
  reservedInventory     Json?
  productionRequirement Json?
  deliverySchedule      Json?
  executiveAssessment   Json?
  riskSignals           Json?
  executiveSummary      Json?
  dynamicAttributes     Json?
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer              Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceQuote           Quote?                  @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  revisions             OrderRevision[]
  exceptions            OrderException[]
  customFieldValues     OrderCustomFieldValue[]
  deliveries            Delivery[]
  calendarEvents         CalendarEvent[]
  productionOrders      ProductionOrder[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, sourceQuoteId])
  @@index([organizationId, deadlineAt])
}

model OrderRevision {
  id             String                  @id @default(cuid())
  organizationId String
  orderId        String
  revisionNumber Int
  changeType     OrderRevisionChangeType
  beforeSnapshot Json
  afterSnapshot  Json
  reason         String?
  performedById  String?
  createdAt      DateTime                @default(now())
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, revisionNumber])
  @@index([organizationId, orderId])
  @@index([orderId, createdAt])
}

model OrderException {
  id             String                 @id @default(cuid())
  organizationId String
  orderId        String
  category       OrderExceptionCategory
  note           String?
  performedById  String?
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([orderId, createdAt])
}

model OrderItem {
  id               String          @id @default(cuid())
  organizationId   String
  orderId          String
  productServiceId String?
  name             String
  unit             String?
  quantity         Decimal         @db.Decimal(14, 3)
  unitPriceCents   BigInt
  lineTotalCents   BigInt
  sortOrder        Int             @default(0)
  removedAt        DateTime?
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productService   ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  deliveryItems    DeliveryItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId])
  @@index([orderId])
  @@index([orderId, sortOrder])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  organizationId String
  orderId        String
  fromStatus     OrderStatus?
  toStatus       OrderStatus
  reason         String?
  performedById  String?
  evidence       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([orderId, createdAt])
}

model OrderCustomFieldValue {
  id             String                @id @default(cuid())
  organizationId String
  orderId        String
  definitionId   String
  valueJson      Json
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  definition     CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([orderId, definitionId])
  @@index([organizationId, orderId])
  @@index([organizationId, definitionId])
}

// ─── Delivery Domain (İrsaliye) ───────────────────────────────────────────────

enum CalendarEventStatus {
  DRAFT
  PLANNED
  CONFIRMED
  CANCELLED
  POSTPONED
  COMPLETED
  ARCHIVED
}
enum CalendarRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
enum CalendarEventSource {
  USER_COMMAND
  EXECUTIVE_DECISION
  SYSTEM
}

enum CalendarEventBlockType {
  MEETING
  FOCUS_TIME
  TRAVEL
  LEAVE
  PRODUCTION
  DO_NOT_DISTURB
  CUSTOMER_VISIT
}

model CalendarEvent {
  id String @id @default(cuid())
  organizationId String
  title String
  description String?
  startAt DateTime
  endAt DateTime
  allDay Boolean @default(false)
  blockType CalendarEventBlockType?
  timeZone String @default("Europe/Istanbul")
  status CalendarEventStatus @default(PLANNED)
  cancellationReason String?
  postponedFromAt DateTime?
  recurrenceFrequency CalendarRecurrenceFrequency?
  recurrenceInterval Int?
  recurrenceUntil DateTime?
  recurrenceCount Int?
  relatedTaskId String?
  relatedCustomerId String?
  relatedOrderId String?
  source CalendarEventSource @default(USER_COMMAND)
  dynamicAttributes Json?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedTask Task? @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  relatedCustomer Customer? @relation(fields: [relatedCustomerId], references: [id], onDelete: SetNull)
  relatedOrder Order? @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  participants CalendarEventParticipant[]
  statusHistory CalendarEventStatusHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, startAt])
  @@index([organizationId, status])
  @@index([organizationId, relatedTaskId])
  @@index([organizationId, relatedCustomerId])
  @@index([organizationId, relatedOrderId])
}

model CalendarEventParticipant {
  id String @id @default(cuid())
  organizationId String
  eventId String
  memberId String?
  customerId String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member OrganizationMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Exactly one participant reference is required; calendar-event.service enforces this invariant.
  @@index([organizationId, eventId])
  @@index([organizationId, memberId])
  @@index([organizationId, customerId])
}

model CalendarEventStatusHistory {
  id String @id @default(cuid())
  organizationId String
  eventId String
  fromStatus CalendarEventStatus?
  toStatus CalendarEventStatus
  reason String?
  performedById String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([organizationId, eventId])
  @@index([eventId, createdAt])
}

enum DeliveryStatus {
  DRAFT
  PREPARING
  PICKING
  PACKING
  LOADED
  DISPATCHED
  AT_DELIVERY_POINT
  DELIVERED
  COMPLETED
  FAILED_DELIVERY
  RESCHEDULED
  CANCELLED
}

enum DeliveryItemCondition {
  OK
  SHORT
  DAMAGED
  WRONG_ITEM
  MIXED
}

enum DeliveryExceptionCategory {
  CUSTOMER_NOT_AT_ADDRESS
  DELIVERY_REFUSED
  PRODUCT_DAMAGED
  VEHICLE_BREAKDOWN
  WRONG_ADDRESS
  SHORTAGE_FOUND
  DELIVERY_POSTPONED
  OTHER
}

model Delivery {
  id                  String                     @id @default(cuid())
  organizationId      String
  deliveryNumber      String
  sourceOrderId       String
  customerId          String
  status              DeliveryStatus             @default(DRAFT)
  warehouse           String?
  dispatchPoint       String?
  deliveryAddress     String?
  carrier             String?
  vehicleInfo         String?
  trackingInfo        String?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  receiverName        String?
  deliveryProof       Json?
  notes               String?
  cancellationReason  String?
  returnRelations     Json?
  executiveAssessment Json?
  riskSignals         Json?
  executiveSummary    Json?
  dynamicAttributes   Json?
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceOrder         Order                      @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  customer            Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items               DeliveryItem[]
  statusHistory       DeliveryStatusHistory[]
  exceptions          DeliveryException[]
  customFieldValues   DeliveryCustomFieldValue[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([organizationId, deliveryNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, sourceOrderId])
}

model DeliveryItem {
  id               String          @id @default(cuid())
  organizationId   String
  deliveryId       String
  orderItemId      String
  productServiceId String?
  name             String
  unit             String?
  quantity         Decimal         @db.Decimal(14, 3)
  conditionFlag    DeliveryItemCondition?
  sortOrder        Int             @default(0)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  delivery         Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem        OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productService   ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId])
  @@index([deliveryId])
  @@index([deliveryId, sortOrder])
  @@index([orderItemId])
}

model DeliveryException {
  id             String                    @id @default(cuid())
  organizationId String
  deliveryId     String
  category       DeliveryExceptionCategory
  note           String?
  performedById  String?
  createdAt      DateTime                  @default(now())
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  delivery       Delivery                  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([organizationId, deliveryId])
  @@index([deliveryId, createdAt])
}

model DeliveryStatusHistory {
  id             String          @id @default(cuid())
  organizationId String
  deliveryId     String
  fromStatus     DeliveryStatus?
  toStatus       DeliveryStatus
  reason         String?
  performedById  String?
  evidence       Json?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  delivery       Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([organizationId, deliveryId])
  @@index([deliveryId, createdAt])
}

model DeliveryCustomFieldValue {
  id             String                @id @default(cuid())
  organizationId String
  deliveryId     String
  definitionId   String
  valueJson      Json
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  delivery       Delivery              @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  definition     CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, definitionId])
  @@index([organizationId, deliveryId])
  @@index([organizationId, definitionId])
}

// ─── Stock Domain (Stok) ──────────────────────────────────────────────────────

enum StockStatus {
  PLANNED
  INCOMING
  RECEIVING
  QUALITY_CONTROL
  AVAILABLE
  RESERVED
  ALLOCATED
  PICKING
  PACKED
  IN_TRANSIT
  DELIVERED
  RETURNED
  QUARANTINE
  DAMAGED
  SCRAPPED
  ARCHIVED
}

enum MovementType {
  RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  RESERVE
  RELEASE_RESERVATION
  CONSUME
  RETURN
  ADJUSTMENT
  SCRAP
}

enum MovementSourceType {
  ORDER
  DELIVERY
  MANUAL
  ADJUSTMENT
  SUPPLIER
}

enum StockCountStatus {
  NO_VARIANCE
  PENDING_INVESTIGATION
  CORRECTED
  DISMISSED
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  type           String?
  address        String?
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks         Stock[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Stock {
  id                String                  @id @default(cuid())
  organizationId    String
  productServiceId  String
  warehouseId       String
  location          String?
  quantity          Decimal                 @default(0) @db.Decimal(14, 3)
  reservedQuantity  Decimal                 @default(0) @db.Decimal(14, 3)
  status            StockStatus             @default(AVAILABLE)
  lot               String?
  batch             String?
  serialNumber      String?
  expiresAt         DateTime?
  dynamicAttributes Json?
  executiveSummary  Json?
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productService    ProductService          @relation(fields: [productServiceId], references: [id], onDelete: Restrict)
  warehouse         Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements         StockMovement[]
  countRecords      StockCountRecord[]
  customFieldValues StockCustomFieldValue[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([organizationId])
  @@index([organizationId, productServiceId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, status])
  @@index([productServiceId, status])
}

model StockCountRecord {
  id                    String           @id @default(cuid())
  organizationId        String
  stockId               String
  systemQuantityAtCount Decimal          @db.Decimal(14, 3)
  countedQuantity       Decimal          @db.Decimal(14, 3)
  varianceQuantity      Decimal          @db.Decimal(14, 3)
  status                StockCountStatus
  investigationNote     String?
  performedById         String?
  correctionMovementId  String?
  resolvedAt            DateTime?
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stock                 Stock            @relation(fields: [stockId], references: [id], onDelete: Cascade)
  createdAt             DateTime         @default(now())

  @@index([organizationId, status])
  @@index([organizationId, stockId, createdAt])
  @@index([correctionMovementId])
}

model StockMovement {
  id              String             @id @default(cuid())
  organizationId  String
  stockId         String
  movementType    MovementType
  quantity        Decimal            @db.Decimal(14, 3)
  fromWarehouseId String?
  toWarehouseId   String?
  fromStatus      StockStatus?
  toStatus        StockStatus?
  sourceType      MovementSourceType
  sourceId        String?
  supplierId      String?
  expectedAt      DateTime?
  unitCostCents   BigInt?
  qualityFlag     String?
  reason          String?
  performedById   String?
  evidence        Json?
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stock           Stock              @relation(fields: [stockId], references: [id], onDelete: Cascade)
  supplier        Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([organizationId])
  @@index([stockId, createdAt])
  @@index([sourceType, sourceId])
  @@index([organizationId, supplierId, movementType])
  @@index([organizationId, movementType])
}

model StockCustomFieldValue {
  id             String                @id @default(cuid())
  organizationId String
  stockId        String
  definitionId   String
  valueJson      Json
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stock          Stock                 @relation(fields: [stockId], references: [id], onDelete: Cascade)
  definition     CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([stockId, definitionId])
  @@index([organizationId, stockId])
  @@index([organizationId, definitionId])
}

// ─── Production Domain (Üretim) ────────────────────────────────────────────────

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum WorkCenterStatus {
  ACTIVE
  INACTIVE
}

enum MachineStatus {
  RUNNING
  IDLE
  MAINTENANCE
  BROKEN
}

model WorkCenter {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  code             String
  status           WorkCenterStatus  @default(ACTIVE)
  notes            String?
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  machines         Machine[]
  productionOrders ProductionOrder[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Machine {
  id             String        @id @default(cuid())
  organizationId String
  workCenterId   String
  name           String
  code           String
  status         MachineStatus @default(IDLE)
  notes          String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workCenter     WorkCenter    @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, workCenterId])
  @@index([organizationId, status])
}

model ProductionOrder {
  id                String                            @id @default(cuid())
  organizationId    String
  orderNumber       String
  status            ProductionOrderStatus             @default(DRAFT)
  sourceOrderId     String?
  productServiceId  String?
  workCenterId      String?
  quantityPlanned   Decimal                           @db.Decimal(14, 3)
  quantityProduced  Decimal                           @default(0) @db.Decimal(14, 3)
  plannedStartAt    DateTime?
  plannedEndAt      DateTime?
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  notes             String?
  executiveSummary  Json?
  riskSignals       Json?
  dynamicAttributes Json?
  organization      Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceOrder       Order?                             @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  productService    ProductService?                   @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  workCenter        WorkCenter?                        @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  statusHistory     ProductionOrderStatusHistory[]
  customFieldValues ProductionOrderCustomFieldValue[]
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, sourceOrderId])
  @@index([organizationId, workCenterId])
}

model ProductionOrderStatusHistory {
  id                String                 @id @default(cuid())
  organizationId    String
  productionOrderId String
  fromStatus        ProductionOrderStatus?
  toStatus          ProductionOrderStatus
  reason            String?
  performedById     String?
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  createdAt         DateTime               @default(now())

  @@index([organizationId, productionOrderId])
  @@index([productionOrderId, createdAt])
}

model ProductionOrderCustomFieldValue {
  id                String                @id @default(cuid())
  organizationId    String
  productionOrderId String
  definitionId      String
  valueJson         Json
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  definition        CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId, definitionId])
  @@index([organizationId, productionOrderId])
  @@index([organizationId, definitionId])
}
