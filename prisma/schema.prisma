  relatedOrderId String?
  source CalendarEventSource @default(USER_COMMAND)
  dynamicAttributes Json?
  reminderSentAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedTask Task? @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  relatedCustomer Customer? @relation(fields: [relatedCustomerId], references: [id], onDelete: SetNull)
  relatedOrder Order? @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  participants CalendarEventParticipant[]
  statusHistory CalendarEventStatusHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, startAt])
  @@index([organizationId, status])
  @@index([organizationId, relatedTaskId])
  @@index([organizationId, relatedCustomerId])
  @@index([organizationId, relatedOrderId])
  @@index([reminderSentAt, startAt])
}

// ============================================================================
// Phase 12 — Calendar Financial Projections + Notifications
//
// Calendar itself gets NO new persisted rows for financial projections —
// CalendarWorkspace already renders a "borrowed" (canonical=false, read-only,
// non-draggable) item type for tasks/invoices/payments/collection-actions
// fetched live alongside real CalendarEvent rows; financial obligations are
// added as a fifth borrowed source (calendar-financial-projection.service.ts),
// computed fresh from ObligationScheduleLine/FinancialInstrument on every
// read — never stored, so there is structurally nothing to desync, duplicate,
// or leave stale. This is the "derived/read-model" the roadmap asks for.
//
// The ONE new table below exists solely to make Notification dispatch
// (which has no dedup of its own — see notification.service.ts) replay-safe
// for financial reminders, mirroring calendar-meeting-reminder.service.ts's
// own `reminderSentAt`-gate pattern, generalized to a source that must
// remain immutable (ObligationScheduleLine/FinancialInstrument can never
// gain a mutable "reminder" column of their own — Phase 5/10's own
// immutability invariant). This table is a pure notification-dispatch
// ledger, not financial truth: dropping it loses reminder history, never
// money.
// ============================================================================

enum FinancialReminderSourceType {
  OBLIGATION_SCHEDULE_LINE
  FINANCIAL_INSTRUMENT
}

enum FinancialReminderKind {
  UPCOMING
  DUE_TODAY
  OVERDUE
}

// One row per (source, kind, calendar day) a reminder was actually sent —
// @@unique makes a repeated scheduler tick on the same day a no-op instead
// of a duplicate notification. dayBucket is computed in the recipient-
// representative timezone (see calendar-timezone.ts), not UTC. Rows are
// never updated or deleted — a new day's scan naturally gets a new
// dayBucket, which is exactly how a settlement reversal that reopens an
// obligation gets a fresh reminder on the next scan without any special-
// cased "un-send" logic.
model FinancialReminderDispatch {
  id             String                       @id @default(cuid())
  organizationId String
  sourceType     FinancialReminderSourceType
  sourceId       String
  reminderKind   FinancialReminderKind
  dayBucket      String
  amount         Decimal                      @db.Decimal(14, 2)
  currency       String
  sentAt         DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceType, sourceId, reminderKind, dayBucket])
  @@index([organizationId, sourceType, sourceId])
}

model CalendarEventParticipant {
  id String @id @default(cuid())
  organizationId String
  eventId String
  memberId String?
  customerId String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member OrganizationMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Exactly one participant reference is required; calendar-event.service enforces this invariant.
  @@index([organizationId, eventId])
  @@index([organizationId, memberId])
  @@index([organizationId, customerId])
}

model CalendarEventStatusHistory {
  id String @id @default(cuid())
  organizationId String
  eventId String
  fromStatus CalendarEventStatus?
  toStatus CalendarEventStatus
  reason String?
  performedById String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([organizationId, eventId])
  @@index([eventId, createdAt])
}

enum DeliveryStatus {
  DRAFT
  PREPARING
  PICKING
  PACKING
  LOADED
  DISPATCHED
  AT_DELIVERY_POINT
  DELIVERED
  COMPLETED
  FAILED_DELIVERY
  RESCHEDULED
  CANCELLED
}

enum DeliveryItemCondition {
  OK
  SHORT
  DAMAGED
  WRONG_ITEM
  MIXED
}

enum DeliveryExceptionCategory {
  CUSTOMER_NOT_AT_ADDRESS
  DELIVERY_REFUSED
  PRODUCT_DAMAGED
  VEHICLE_BREAKDOWN
  WRONG_ADDRESS
  SHORTAGE_FOUND
  DELIVERY_POSTPONED
  OTHER
}

model Delivery {
  id                  String                     @id @default(cuid())
  organizationId      String
  deliveryNumber      String
  sourceOrderId       String
  customerId          String
  status              DeliveryStatus             @default(DRAFT)
  warehouse           String?
  dispatchPoint       String?
  deliveryAddress     String?
  carrier             String?
  vehicleInfo         String?
  trackingInfo        String?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  receiverName        String?
  deliveryProof       Json?
  notes               String?
  cancellationReason  String?
  returnRelations     Json?
  executiveAssessment Json?
  riskSignals         Json?
  executiveSummary    Json?
  dynamicAttributes   Json?
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceOrder         Order                      @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  customer            Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items               DeliveryItem[]
