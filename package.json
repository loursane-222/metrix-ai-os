{
  "name": "metrix-ai-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:preflight": "node scripts/db-preflight.mjs",
    "dev": "npm run db:preflight && next dev",
    "dev:webpack": "npm run db:preflight && next dev",
    "dev:safe": "npm run db:preflight && next dev",
    "dev:clean": "node scripts/local-dev.mjs dev",
    "dev:doctor": "node scripts/local-dev.mjs doctor",
    "local:dev": "npm run db:preflight && next dev",
    "local:clean": "rm -rf .next",
    "local:preview": "node scripts/local-dev.mjs preview",
    "check:text-quality": "node scripts/check-user-facing-text.mjs",
    "check:organization-scoping": "node scripts/check-organization-scoping.mjs",
    "build": "npm run check:text-quality && npm run check:organization-scoping && node scripts/production-migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:performance": "vitest run --config vitest.perf.config.ts --reporter=verbose",
    "test:production-acceptance": "vitest run --config vitest.production-acceptance.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@openai/agents": "^0.17.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "next": "15.5.19",
    "openai": "^6.42.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.21.0",
    "pptxgenjs": "^4.0.1",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "resend": "^6.14.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
